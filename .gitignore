# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# patch-script scratch — never commit
*.bak-*
patch_*.py
install_*.py
compliance_refactor.py
*.zip
*.bak.*
# Same class as *.bak.*: a timestamped copy an agent left behind mid-edit.
# One of these reached a commit (a solutions page), which is what added it here.
*.broken.*
.next.broken*/
# Videos stay out of git: the 04:30 UTC media backup copies mp4 and pdf files
# to Spaces. It does not copy jpg, so the AEO lesson posters are committed
# (src/lib/aeo-course/video.ts). `*`, not the directory, so the ! can apply.
public/videos/*
!public/videos/aeo-*-poster.jpg

# local Claude Code settings — contains credentials in permission rules
.claude/settings.local.json
learn-content/
/.next-check/
# scripts/deploy.sh: the build being made, and the one it replaced (for --rollback)
/.next-build/
/.next-prev/
