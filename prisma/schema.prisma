generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum PlanType {
  AI_VISIBILITY
  STARTER
  GROWTH
  AGENCY
  ENTERPRISE
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum FeedbackStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

enum CustomerStatus {
  NEW
  CONTACTED
  SATISFIED
  NEEDS_FOLLOWUP
  RECOVERED
  LOST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  passwordHash    String?
  termsAcceptedAt DateTime?
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     TenantMember[]
  accounts        Account[]
  sessions        Session[]
  auditLogs       AuditLog[]
  extensionTokens ExtensionToken[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Tenant {
  id                    String        @id @default(cuid())
  name                  String
  slug                  String        @unique
  logo                  String?
  brandPrimaryColor     String        @default("#2563eb")
  brandSecondaryColor   String        @default("#1e40af")
  supportEmail          String?
  googleReviewLink      String?
  facebookReviewLink    String?
  trustpilotLink        String?
  defaultLanguage       String        @default("en")
  timezone              String        @default("America/New_York")
  planType              PlanType      @default(STARTER)
  monthlyRequestLimit   Int           @default(300)
  billingStatus         BillingStatus @default(TRIALING)
  /// Marketing Studio brand voice, produced by category 08's heuristic and
  /// saved by the tenant. Prepended to every generation's system prompt when
  /// set. Text, not JSON: it is written straight into a prompt.
  brandVoiceGuide       String?       @map("brand_voice_guide") @db.Text
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  whitelabel            Boolean       @default(false)
  customDomain          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  welcomeSeenAt         DateTime?
  onboardingDismissedAt DateTime?
  onboardingIntent      String? // "business" | "agency"
  auditDomain           String? // domain captured from the landing audit widget or the welcome modal
  // Explicit domain for Bot Analytics, set on the tool page itself. Separate
  // from auditDomain so the tool is self-sufficient for a tenant that never ran
  // an AI Visibility audit, and so overriding it here cannot disturb onboarding.
  botAnalyticsDomain    String?
  onboarding            Json? // { pdfDownloadedAt?, roadmapViewedAt?, firstAuditScore?, firstAuditAt?, profileCompletedAt? }
  marketingConsent      Boolean       @default(true)

  members            TenantMember[]
  visibilityMonitors VisibilityMonitor[]
  visibilityAudits   VisibilityAudit[]
  trackedPrompts     TrackedPrompt[]
  promptRuns         PromptRun[]
  customers          Customer[]
  feedback           Feedback[]
  reviewLinks        ReviewLink[]
  emailTemplates     EmailTemplate[]
  smsTemplates       SmsTemplate[]
  recoveryTickets    RecoveryTicket[]
  emailLogs          EmailLog[]
  smsLogs            SmsLog[]
  campaigns          Campaign[]
  subscription       Subscription?
  auditLogs          AuditLog[]
  domainEvents       DomainEvent[]
  usageMeters        UsageMeter[]
  usageSnapshots     UsageSnapshot[]
  quota              TenantQuota?
  retentionPolicy    DataRetentionPolicy?
  deletionLogs       DeletionLog[]
  reputationScores   ReputationScore[]
  aiAnalyses         AiAnalysis[]
  escalationAlerts   EscalationAlert[]
  monitoringSources  MonitoringSource[]
  externalReviews    ExternalReview[]
  importJobs         ImportJob[]
  extensionTokens    ExtensionToken[]
  apiKeys            ApiKey[]
  gscConnection      GscConnection?
  gaConnection       GaConnection?
  gscQueryStats      GscQueryStat[]
  aiLensAnalyses     AiLensAnalysis[]
  botAccessChecks    BotAccessCheck[]
  botLogAnalyses     BotLogAnalysis[]
  contentSearches    ContentSearch[]

  @@map("tenants")
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

model Customer {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  email           String?
  phone           String?
  status          CustomerStatus   @default(NEW)
  tags            String[]
  location        String?
  metadata        Json?
  deletedAt       DateTime?
  archivedAt      DateTime?
  legalHold       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback        Feedback[]
  emailLogs       EmailLog[]
  smsLogs         SmsLog[]
  recoveryTickets RecoveryTicket[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@map("customers")
}

model Feedback {
  id             String          @id @default(cuid())
  tenantId       String
  customerId     String
  campaignId     String?
  rating         Int?
  comment        String?
  status         FeedbackStatus  @default(PENDING)
  token          String          @unique
  submittedAt    DateTime?
  routedAt       DateTime?
  expiresAt      DateTime?
  deletedAt      DateTime?
  legalHold      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id])
  reviewRequest  ReviewRequest?
  recoveryTicket RecoveryTicket?

  @@index([tenantId])
  @@index([token])
  @@index([tenantId, status])
  @@index([tenantId, rating])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, campaignId])
  @@index([status, routedAt])
  @@map("feedback")
}

model ReviewLink {
  id        String   @id @default(cuid())
  tenantId  String
  platform  String
  url       String
  label     String?
  location  String?
  isDefault Boolean  @default(false)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("review_links")
}

model ReviewRequest {
  id         String    @id @default(cuid())
  feedbackId String    @unique
  platform   String
  url        String
  clicked    Boolean   @default(false)
  clickedAt  DateTime?
  sentAt     DateTime  @default(now())
  feedback   Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("review_requests")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  body      String
  type      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("email_templates")
}

model SmsTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  body      String
  type      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sms_templates")
}

model RecoveryTicket {
  id         String         @id @default(cuid())
  tenantId   String
  customerId String
  feedbackId String         @unique
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  assignedTo String?
  notes      String?
  resolvedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, createdAt])
  @@map("recovery_tickets")
}

model EmailLog {
  id                String         @id @default(cuid())
  tenantId          String
  customerId        String
  to                String
  subject           String
  body              String
  status            MessageStatus  @default(QUEUED)
  channel           MessageChannel @default(EMAIL)
  // Brevo's message-id (Message-Id header it assigns at relay time). Captured
  // at send for debugging/joins. NOTE: Brevo's SMTP relay rewrites Message-Id,
  // so this is NOT a reliable webhook-correlation key on its own — webhook
  // correlation uses the X-Mailin-custom token carrying this row's id instead.
  providerMessageId String?
  // Lifecycle timestamps populated by Brevo webhook events.
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime       @default(now())
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([customerId, tenantId])
  @@index([providerMessageId])
  @@map("email_logs")
}

model SmsLog {
  id                String        @id @default(cuid())
  tenantId          String
  customerId        String
  to                String
  body              String
  status            MessageStatus @default(QUEUED)
  // Brevo SMS message-id returned by the send API. Unlike email, the SMS API
  // response id matches the webhook's message id, so this IS the correlation key.
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([providerMessageId])
  @@map("sms_logs")
}

model Campaign {
  id             String         @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  channel        MessageChannel @default(EMAIL)
  status         CampaignStatus @default(DRAFT)
  location       String?
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  totalSent      Int            @default(0)
  totalResponses Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback       Feedback[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("campaigns")
}

model Subscription {
  id                   String        @id @default(cuid())
  tenantId             String        @unique
  planType             PlanType
  status               BillingStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  stripeSubscriptionId String?
  stripePriceId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entity])
  @@map("audit_logs")
}

// ─── PHASE 2: Domain Events ────────────────────────────────────────────

enum DomainEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model DomainEvent {
  id            String            @id @default(cuid())
  tenantId      String
  eventType     String
  eventVersion  Int               @default(1)
  aggregateType String
  aggregateId   String
  payload       Json
  metadata      Json?
  status        DomainEventStatus @default(PENDING)
  correlationId String?
  causationId   String?
  retryCount    Int               @default(0)
  maxRetries    Int               @default(3)
  processedAt   DateTime?
  failedAt      DateTime?
  error         String?
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventType, aggregateId, correlationId], name: "event_idempotency_key")
  @@index([tenantId])
  @@index([eventType])
  @@index([status])
  @@index([correlationId])
  @@index([createdAt])
  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
  @@map("domain_events")
}

// ─── PHASE 4: Usage Metering ───────────────────────────────────────────

enum MeterType {
  EMAIL_SENT
  SMS_SENT
  WEBHOOK_CALL
  API_REQUEST
  AI_TOKEN_USAGE
  AI_INFERENCE
  REVIEW_CONVERSION
  ESCALATION_EVENT
  FEEDBACK_REQUEST
  MONITORING_CHECK
}

model UsageMeter {
  id         String    @id @default(cuid())
  tenantId   String
  meterType  MeterType
  quantity   Int       @default(1)
  unitCost   Float     @default(0)
  metadata   Json?
  recordedAt DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, meterType])
  @@index([tenantId, recordedAt])
  @@map("usage_meters")
}

model UsageSnapshot {
  id                String   @id @default(cuid())
  tenantId          String
  periodStart       DateTime
  periodEnd         DateTime
  emailsSent        Int      @default(0)
  smsSent           Int      @default(0)
  webhookCalls      Int      @default(0)
  apiRequests       Int      @default(0)
  aiTokensUsed      Int      @default(0)
  aiInferences      Int      @default(0)
  aiCost            Float    @default(0)
  feedbackRequests  Int      @default(0)
  reviewConversions Int      @default(0)
  escalationEvents  Int      @default(0)
  monitoringChecks  Int      @default(0)
  totalCost         Float    @default(0)
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId])
  @@map("usage_snapshots")
}

model TenantQuota {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  maxEmailsPerMonth       Int      @default(300)
  maxSmsPerMonth          Int      @default(0)
  maxWebhooksPerMonth     Int      @default(1000)
  maxApiRequestsPerDay    Int      @default(10000)
  maxAiInferencesPerMonth Int      @default(100)
  maxMonitoringChecks     Int      @default(0)
  overageAllowed          Boolean  @default(false)
  overageRateEmail        Float    @default(0.01)
  overageRateSms          Float    @default(0.05)
  overageRateAi           Float    @default(0.02)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_quotas")
}

// ─── PHASE 5: Soft Delete & Compliance ─────────────────────────────────

model DataRetentionPolicy {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  feedbackRetentionDays Int      @default(730)
  customerRetentionDays Int      @default(1095)
  auditLogRetentionDays Int      @default(2555)
  eventRetentionDays    Int      @default(365)
  autoDeleteEnabled     Boolean  @default(false)
  gdprCompliant         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("data_retention_policies")
}

model DeletionLog {
  id           String    @id @default(cuid())
  tenantId     String
  entityType   String
  entityId     String
  deletedBy    String?
  reason       String?
  legalHold    Boolean   @default(false)
  restorable   Boolean   @default(true)
  snapshotData Json?
  deletedAt    DateTime  @default(now())
  expiresAt    DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("deletion_logs")
}

// ─── PHASE 6: AI Reputation Intelligence ───────────────────────────────

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model ReputationScore {
  id                  String    @id @default(cuid())
  tenantId            String
  location            String?
  overallScore        Float
  sentimentScore      Float
  responseRateScore   Float
  recoveryScore       Float
  reviewVelocityScore Float
  volatilityIndex     Float     @default(0)
  riskLevel           RiskLevel @default(LOW)
  trendDirection      String    @default("stable")
  periodStart         DateTime
  periodEnd           DateTime
  sampleSize          Int       @default(0)
  confidence          Float     @default(0)
  createdAt           DateTime  @default(now())
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, location])
  @@index([tenantId, createdAt])
  @@map("reputation_scores")
}

model AiAnalysis {
  id                    String    @id @default(cuid())
  tenantId              String
  feedbackId            String?
  externalReviewId      String?
  analysisType          String
  sentimentLabel        String?
  sentimentScore        Float?
  escalationProbability Float?
  publicPostProbability Float?
  churnProbability      Float?
  riskLevel             RiskLevel @default(LOW)
  intent                String?
  entities              Json?
  emotions              Json?
  topics                Json?
  suggestedAction       String?
  confidence            Float     @default(0)
  modelId               String?
  promptTokens          Int       @default(0)
  completionTokens      Int       @default(0)
  latencyMs             Int       @default(0)
  createdAt             DateTime  @default(now())
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([feedbackId])
  @@index([analysisType])
  @@index([riskLevel])
  @@index([tenantId, createdAt])
  @@map("ai_analyses")
}

model EscalationAlert {
  id               String    @id @default(cuid())
  tenantId         String
  customerId       String?
  feedbackId       String?
  externalReviewId String?
  alertType        String
  riskLevel        RiskLevel
  probability      Float
  title            String
  description      String
  suggestedAction  String?
  acknowledged     Boolean   @default(false)
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, riskLevel])
  @@index([tenantId, acknowledged])
  @@map("escalation_alerts")
}

// ─── PHASE 7: External Reputation Monitoring ───────────────────────────

enum MonitoringPlatform {
  GOOGLE
  FACEBOOK
  TRUSTPILOT
  YELP
  REDDIT
  TWITTER
  TIKTOK
  YOUTUBE
  APP_STORE
  CUSTOM
}

model MonitoringSource {
  id            String             @id @default(cuid())
  tenantId      String
  platform      MonitoringPlatform
  externalId    String
  name          String
  url           String?
  credentials   Json?
  isActive      Boolean            @default(true)
  lastCheckedAt DateTime?
  checkInterval Int                @default(3600)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews       ExternalReview[]
  importJobs    ImportJob[]

  @@unique([tenantId, platform, externalId])
  @@index([tenantId])
  @@map("monitoring_sources")
}

model ExternalReview {
  id               String             @id @default(cuid())
  tenantId         String
  sourceId         String
  platform         MonitoringPlatform
  externalId       String
  authorName       String?
  authorUrl        String?
  rating           Float?
  content          String?
  language         String?
  publishedAt      DateTime?
  url              String?
  replyContent     String?
  repliedAt        DateTime?
  sentimentLabel   String?
  sentimentScore   Float?
  riskLevel        RiskLevel          @default(LOW)
  isProcessed      Boolean            @default(false)
  deduplicationKey String             @unique
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source           MonitoringSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, platform])
  @@index([tenantId, riskLevel])
  @@index([sourceId])
  @@index([publishedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, sentimentLabel])
  @@map("external_reviews")
}

// ─── PHASE 3: Observability ────────────────────────────────────────────

model SystemMetric {
  id         String   @id @default(cuid())
  tenantId   String?
  metricName String
  value      Float
  tags       Json?
  recordedAt DateTime @default(now())

  @@index([metricName, recordedAt])
  @@index([tenantId, metricName])
  @@map("system_metrics")
}

// ─── Processed Webhooks (Stripe idempotency) ──────────────────────────

model ProcessedWebhook {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())
  payload       Json?

  @@index([eventType])
  @@map("processed_webhooks")
}

// ─── Brevo (email/SMS) webhook events ─────────────────────────────────
// Brevo does not send a unique event id (unlike Stripe), so idempotency is
// enforced via a deterministic dedup key derived from the message id, event
// type, and event timestamp. The unique constraint makes replays no-ops, the
// same way ProcessedWebhook.stripeEventId does for Stripe.
model MessageEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  channel    String // EMAIL | SMS
  event      String // delivered | opened | click | hard_bounce | ...
  recipient  String?
  messageId  String?
  emailLogId String?
  smsLogId   String?
  dedupeKey  String   @unique
  payload    Json?
  occurredAt DateTime
  receivedAt DateTime @default(now())

  @@index([tenantId])
  @@index([emailLogId])
  @@index([smsLogId])
  @@index([event])
  @@map("message_events")
}

// ─── Stripe multi-currency price catalog ───────────────────────────────
// One Stripe Price object exists per (tier, currency, interval). Rather than
// fanning these out as env vars (4 tiers x 5 currencies = 20), they are
// resolved from this table at checkout/webhook time. `active` lets old prices
// be retired without deletion; lookups always filter on active = true.
/// One row per SUCCESSFUL Anthropic call from Marketing Studio.
///
/// Heuristic-only work writes nothing here — it costs nothing, so metering it
/// would overstate spend and make the monthly budget deny work that was free.
/// Cache-served results write nothing either, for the same reason.
model AiApiCall {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  categoryId      String   @map("category_id")
  model           String
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  /// From the API usage block. Expected to stay 0 on Haiku 4.5 — the shared
  /// prefix is ~500 tokens against a 4096-token minimum, so nothing caches.
  /// Recorded anyway so the assumption is measurable rather than asserted.
  cacheReadTokens Int      @default(0) @map("cache_read_tokens")
  createdAt       DateTime @default(now()) @map("created_at")

  /// The budget query is "output tokens for this tenant this month".
  @@index([tenantId, createdAt])
  @@map("ai_api_calls")
}

model StripePrice {
  id            String   @id @default(cuid())
  stripePriceId String   @unique @map("stripe_price_id")
  planTier      String   @map("plan_tier") // starter | growth | agency | enterprise
  currency      String // USD | EUR | GBP | CAD | CHF
  interval      String   @default("month") // month | year
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([planTier, currency, interval, active])
  @@map("stripe_prices")
}

// ─── Soft Delete Additions to Existing Models ──────────────────────────
// Note: deletedAt, archivedAt, legalHold fields are added to core models
// via the compliance middleware layer rather than schema changes, to avoid
// breaking the existing API. The DeletionLog table tracks all deletions.

// ─── CSV / file import jobs ────────────────────────────────────────────
// A multi-source ingestion record. Reviews uploaded via CSV (and, later,
// Excel/Sheets/Airtable) are attached to a synthetic MonitoringSource so they
// flow through the exact same normalize → dedup → AiAnalysis → reputation /
// escalation pipeline as platform-monitored reviews. This table is the import
// history + column-mapping wizard state machine, and (for v1) the staging
// store for the raw uploaded text between the preview and commit steps.
enum ImportStatus {
  PENDING_MAPPING // uploaded + parsed headers; awaiting column-mapping confirmation
  QUEUED // mapping confirmed; csv-import job enqueued
  PROCESSING // worker is ingesting rows
  COMPLETED // all rows ingested (some may have been duplicates)
  PARTIAL // completed, but one or more rows failed validation
  FAILED // job-level failure (parse error, etc.)
  CANCELLED // user discarded before commit
}

enum ImportSourceFormat {
  GENERIC_CSV
  GOOGLE_CSV
  FACEBOOK_CSV
  TRUSTPILOT_CSV
  EXCEL // reserved for the .xlsx slice (Feature 4); parsed to rows then shares this pipeline
  EXTENSION // browser-extension scraped import; rows arrive pre-structured as JSON
}

model ImportJob {
  id              String             @id @default(cuid())
  tenantId        String
  // The synthetic MonitoringSource these rows are attached to. Nullable so a
  // discarded (CANCELLED) or failed-at-parse import need not allocate a source.
  sourceId        String?
  filename        String
  format          ImportSourceFormat @default(GENERIC_CSV)
  // Platform the rows represent — drives the dedup namespace and dashboards.
  platform        MonitoringPlatform @default(CUSTOM)
  status          ImportStatus       @default(PENDING_MAPPING)
  // Raw uploaded text, retained for re-parse at commit time. Capped at the
  // route layer (see MAX_IMPORT_BYTES). For very large files this should move
  // to object storage; kept in-row for v1 since review exports are small.
  rawContent      String?            @db.Text
  hasHeaderRow    Boolean            @default(true)
  // Header names detected at parse time: string[].
  detectedColumns Json?
  // Confirmed mapping of canonical field -> source column, e.g.
  // { "rating": "Star Rating", "content": "Review", "author": "Name" }.
  columnMapping   Json?
  totalRows       Int                @default(0)
  importedRows    Int                @default(0)
  duplicateRows   Int                @default(0)
  failedRows      Int                @default(0)
  // Up to N row-level errors: [{ row: number, message: string }].
  errors          Json?
  errorMessage    String? // job-level failure reason
  createdById     String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source MonitoringSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([sourceId])
  @@map("import_jobs")
}

/// Long-lived API token issued to a logged-in user for the browser extension.
/// Only a SHA-256 hash of the secret is stored; the plaintext is shown once at
/// creation. Tokens are tenant-scoped, revocable, and rotatable (rotation =
/// revoke old + issue new, preserving label/scopes).
model ExtensionToken {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  /// Human label set at creation, e.g. "Chrome on work laptop".
  label      String
  /// SHA-256 (hex) of the token secret. Never store plaintext.
  tokenHash  String    @unique
  /// First 8 chars of the public token id, surfaced in the UI for identification.
  prefix     String
  /// Reserved for future per-token scoping (e.g. ["import:write"]).
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  /// Optional hard expiry. Null = no expiry (revoke to disable).
  expiresAt  DateTime?
  /// Set when revoked; a non-null value disables the token.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tokenHash])
  @@map("extension_tokens")
}

enum VisibilityCadence {
  DAILY
  WEEKLY
}

model VisibilityMonitor {
  id        String            @id @default(cuid())
  tenantId  String
  url       String
  cadence   VisibilityCadence @default(WEEKLY)
  active    Boolean           @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime          @default(now())
  // Snapshot of the last completed audit for cheap diffing + list views.
  lastScore Int?
  lastGrade String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audits VisibilityAudit[]

  @@unique([tenantId, url])
  @@index([active, nextRunAt])
  @@map("visibility_monitors")
}

model VisibilityAudit {
  id        String   @id @default(cuid())
  tenantId  String
  monitorId String?
  url       String
  score     Int
  grade     String
  // checks[] and robots.bots snapshots from the sidecar, for diffing + trend UI.
  checks    Json
  bots      Json
  raw       Json?
  createdAt DateTime @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  monitor VisibilityMonitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([monitorId, createdAt])
  @@map("visibility_audits")
}

model TrackedPrompt {
  id        String    @id @default(cuid())
  tenantId  String
  text      String
  active    Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   PromptRun[]

  @@unique([tenantId, text])
  @@index([active, nextRunAt])
  @@map("tracked_prompts")
}

model PromptRun {
  id             String   @id @default(cuid())
  tenantId       String
  promptId       String
  engine         String   @default("claude")
  model          String
  brandMentioned Boolean
  brandRank      Int?
  // [{name, mentioned}] snapshot at run time.
  competitors    Json
  excerpt        String?  @db.Text
  error          String?
  createdAt      DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prompt TrackedPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([promptId, createdAt])
  @@map("prompt_runs")
}

// ─────────────────────────────────────────────────────────────
// SIGNAL SPINE — paste these two models into prisma/schema.prisma
// then: npx prisma db push  (or use prisma/migration.sql manually)
// If your tenant FK convention is different (e.g. organizationId),
// find/replace `tenantId` here AND in src/lib/signals/*.
// ─────────────────────────────────────────────────────────────

model Signal {
  id         String   @id @default(cuid())
  tenantId   String
  source     String // review | feedback | visibility | support | social | news | competitor | manual
  externalId String? // stable id in the source system (review id, audit id…)
  dedupeHash String   @unique
  entityType String? // location | customer | …
  entityId   String?
  occurredAt DateTime
  ingestedAt DateTime @default(now())
  sentiment  Float // -1..1
  severity   Float // 0..1
  magnitude  Float    @default(0.5) // 0..1 reach/weight of the signal
  title      String?
  body       String?  @db.Text
  url        String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, source, occurredAt(sort: Desc)])
}

model RiskSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  day         DateTime @db.Date
  score       Int // 0..100, higher = more risk
  grade       String // A..F
  components  Json
  drivers     Json
  signalCount Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, day])
  @@index([tenantId, day(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// PHASE 2 — AlertEvent + TenantRiskConfig
// deploy-phase2.sh appends this automatically (with backup).
// ─────────────────────────────────────────────────────────────

model AlertEvent {
  id         String    @id @default(cuid())
  tenantId   String
  kind       String // risk_threshold | risk_spike | critical_signal
  severity   String // warning | critical
  title      String
  body       String?
  dedupeKey  String    @unique
  payload    Json?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([notifiedAt, createdAt])
}

model TenantRiskConfig {
  tenantId       String   @id
  monthlyRevenue Float?
  currency       String   @default("USD")
  riskElasticity Float    @default(0.10)
  alertEmails    String? // comma-separated; falls back to ALERT_FALLBACK_EMAIL
  alertsEnabled  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// PHASE 3 — Competitor + CompetitorSnapshot
// deploy-phase3.sh appends this automatically (with backup).
// ─────────────────────────────────────────────────────────────

model Competitor {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  placeId   String? // Google Places (v1) id → automated daily snapshots
  address   String? // formatted address / vicinity — disambiguates chains
  platform  String   @default("google")
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots CompetitorSnapshot[]

  @@unique([tenantId, placeId])
  @@index([tenantId, active])
}

model CompetitorSnapshot {
  id           String   @id @default(cuid())
  competitorId String
  day          DateTime @db.Date
  rating       Float?
  reviewCount  Int?
  raw          Json?
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, day])
  @@index([competitorId, day(sort: Desc)])
}

/// Tenant-scoped public-API keys (SEO Tools "API access"). Mirrors the
/// ExtensionToken design: opaque bearer `er_api_<id>.<secret>`, SHA-256 of
/// the secret stored (never plaintext), instant revocation via revokedAt.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  /// Human label set at creation, e.g. "CI pipeline".
  label      String
  /// SHA-256 (hex) of the secret segment. Never store plaintext.
  keyHash    String    @unique
  /// First 8 chars of the public id segment, surfaced for identification.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

/// Google Search Console connection (SEO Tools "GSC Insights"). One per
/// tenant. The OAuth refresh token is stored AES-256-GCM-encrypted
/// (src/lib/gsc/crypto.ts, key derived from GSC_TOKEN_ENCRYPTION_KEY) —
/// never in plaintext, never logged.
model GscConnection {
  id              String              @id @default(cuid())
  tenantId        String              @unique
  /// v1:<iv>:<tag>:<ciphertext> (base64url segments)
  refreshTokenEnc String
  googleEmail     String?
  /// Chosen GSC property (e.g. "sc-domain:example.com"); null until picked.
  siteUrl         String?
  status          GscConnectionStatus @default(ACTIVE)
  connectedAt     DateTime            @default(now())
  lastSyncAt      DateTime?
  /// Rows the last sync stored. lastSyncAt alone cannot tell "the sync ran and
  /// saved rows" apart from "the sync ran and saved none" — and the second is
  /// the normal outcome on a low-traffic property, where Google withholds
  /// queries below its anonymity threshold. Null means never synced.
  lastRowsSynced  Int?
  updatedAt       DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("gsc_connections")
}

enum GscConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
}

/// Daily query-level Search Console rows (nightly sync + manual sync). The
/// Rank Tracker foundation: page = "" marks the query-only aggregate row —
/// an empty-string sentinel rather than NULL so the composite unique key
/// works (Postgres treats NULLs as distinct in unique constraints).
model GscQueryStat {
  id          String   @id @default(cuid())
  tenantId    String
  siteUrl     String
  date        DateTime @db.Date
  query       String
  page        String   @default("")
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, query, page])
  @@index([tenantId, query, date])
  @@index([tenantId, date])
  @@map("gsc_query_stats")
}

// -----------------------------------------------------------------------------
// Classic SEO Tools — Phase 0 models (metering + caches).
// NOTE: migration history is unreplayable (docs/agents/BLOCKERS.md §5) —
// use `prisma migrate diff` + `migrate deploy`, not `migrate dev`.
// -----------------------------------------------------------------------------

/// One billed DataForSEO call. Carries TWO different aggregates, and conflating
/// them is the mistake this comment exists to prevent:
///
///   SPEND  — SUM(costUsd) WHERE ok, over the calendar month. Bills what
///            DataForSEO actually charged, which happens at task_post: a
///            standard-queue task that is posted and later fails was still
///            paid for, so it must stay in this sum.
///   QUOTA  — COUNT(*) WHERE resultAt IS NOT NULL, over the same window. The
///            user-facing "searches used" number, which may only count calls
///            that produced something the tenant can look at.
///
/// `ok` therefore means "DataForSEO accepted and billed the call", NOT "the
/// tenant got an answer". For live endpoints the two coincide and resultAt is
/// stamped at insert. For the standard queue they are minutes apart, and a task
/// can be billed at post and still never return a result.
model SeoApiCall {
  id               String    @id @default(cuid())
  tenantId         String
  feature          String // domain_overview | keyword_research | backlinks | rank_tracking | site_audit | local_seo | content_research
  path             String // "v3/dataforseo_labs/google/ranked_keywords/live"
  costUsd          Decimal   @db.Decimal(10, 6)
  /// Billed by DataForSEO. Drives the USD cap; never the search quota.
  ok               Boolean
  /// Set when a usable result exists — at insert for live calls, by the
  /// standard-queue poller for task_post calls. NULL means posted-but-unresolved
  /// or failed, and is excluded from the search quota by design.
  resultAt         DateTime?
  /// DataForSEO's task uuid, for standard-queue calls only. The poller has the
  /// task id and nothing else, so this is how it finds the row to stamp.
  dataforseoTaskId String?
  createdAt        DateTime  @default(now())

  @@index([tenantId, createdAt])
  /// The quota aggregate: one tenant, one month, successful rows only.
  @@index([tenantId, resultAt])
  /// Poller lookup by task id.
  @@index([dataforseoTaskId])
}

model SeoDomainSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  target       String
  locationCode Int
  languageCode String
  payload      Json
  fetchedAt    DateTime @default(now())

  @@unique([tenantId, target, locationCode, languageCode])
}

model SeoKeywordOverviewCache {
  id           String   @id @default(cuid())
  tenantId     String
  keyword      String
  locationCode Int
  languageCode String
  payload      Json
  fetchedAt    DateTime @default(now()) // 7 d TTL, enforced in code

  @@unique([tenantId, keyword, locationCode, languageCode])
}

/// SERP Checker — one row per submitted DataForSEO standard-queue task.
/// The POST route writes it as `queued`; the serp-checks worker polls
/// tasks_ready and fills `results` + `serpFeatures`, or `error`.
///
/// The search params are columns rather than a JSON blob because the 24 h
/// cache lookup queries on all four of them together (see the composite index).
model SerpCheck {
  id               String    @id @default(cuid())
  tenantId         String
  keyword          String
  locationCode     Int
  languageCode     String
  device           String // desktop | mobile
  dataforseoTaskId String?   @unique
  status           String    @default("queued") // queued | completed | failed
  costUsd          Decimal   @default(0) @db.Decimal(10, 6)
  results          Json? // { items: SerpResultItem[] } — top 100 organic
  serpFeatures     Json? // string[] of non-organic element types present
  itemCount        Int?
  error            String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  // Cache lookup: newest completed check for this exact query.
  @@index([tenantId, keyword, locationCode, languageCode, device, status, createdAt])
  // History list.
  @@index([tenantId, createdAt])
  // Worker sweep: queued rows, oldest first.
  @@index([status, createdAt])
}

/// Site Explorer — one row per domain analysis. An analysis is FOUR live
/// DataForSEO calls (domain_rank_overview, ranked_keywords, competitors_domain,
/// backlinks/summary) run in sequence inside a single POST; each is sub-second,
/// so there is no worker and no `queued` state.
///
/// Sections are stored independently and `failedSections` names the ones that
/// did not come back: a partial analysis is worth keeping (and worth showing)
/// rather than discarding three good sections because one endpoint 500'd.
///
/// locationCode/languageCode are columns, not a params blob, because the 24 h
/// per-(tenant, domain) cache lookup queries on them (see the composite index).
model SiteExplorerAnalysis {
  id             String   @id @default(cuid())
  tenantId       String
  domain         String // normalized: no scheme, no www., no path, lowercase
  locationCode   Int
  languageCode   String
  status         String   @default("completed") // completed | partial
  costUsd        Decimal  @default(0) @db.Decimal(10, 6)
  overview       Json? // OverviewSection — traffic, keyword count, rank spread
  rankedKeywords Json? // RankedKeywordsSection — top 100 rows
  competitors    Json? // CompetitorsSection — top 20 rows
  backlinks      Json? // BacklinksSection — link profile headline metrics
  failedSections Json? // string[] of section keys that did not load
  createdAt      DateTime @default(now())

  // Cache lookup: newest analysis for this exact target.
  @@index([tenantId, domain, locationCode, languageCode, createdAt])
  // History list.
  @@index([tenantId, createdAt])
}

/// AI Lens — one measurement of what an AI answer engine sees on one URL.
/// The sidecar fetches the page twice (raw HTTP as GPTBot, then rendered in
/// chromium) and diffs the two markdown renderings; this row is the result.
///
/// url is stored as submitted-then-normalized (scheme + host + path, no
/// fragment), NOT reduced to a domain: the whole point is per-page, and two
/// pages on one site routinely have very different gaps.
model AiLensAnalysis {
  id                String   @id @default(cuid())
  tenantId          String
  url               String
  /// Percent of RENDERED words absent from the raw fetch. 0 = fully readable.
  /// One decimal, so Decimal not Int — 0.4% and 0% are different answers.
  gapPercent        Decimal  @db.Decimal(5, 1)
  rawWordCount      Int
  renderedWordCount Int
  /// [{text_excerpt, approx_location, word_count}] — capped by the sidecar.
  missingBlocks     Json
  /// Status codes, fetch timings, redirects, robots/noindex flags, the UA used.
  meta              Json
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Cache lookup: newest analysis for this exact URL.
  @@index([tenantId, url, createdAt])
  // History list.
  @@index([tenantId, createdAt])
  @@map("ai_lens_analyses")
}

/// Bot Analytics — one active access check for one domain.
///
/// Two signals per bot, and the pair is the point: `robotsRule` is what the site
/// SAYS, `httpStatus` is what the edge actually DID when we asked as that bot.
/// A site can publish "Allow: /" and still have its WAF return 403 to GPTBot;
/// robots.txt-only reporting calls that site open to ChatGPT when it is not.
///
/// `results` is per-bot rather than columns because the bot list is config
/// (src/lib/bot-catalog.ts) and grows — Meta added meta-externalagent after this
/// tool shipped. A column per crawler would mean a migration per crawler.
model BotAccessCheck {
  id            String   @id @default(cuid())
  tenantId      String
  /// Hostname checked, normalized. Stored per row so history stays readable
  /// after the tenant points the tool at a different site.
  domain        String
  /// { "<token>": { robotsRule, httpStatus, verdict, detail, probed } }
  /// verdict: allowed | blocked_robots | blocked_http | challenged | unknown
  results       Json
  robotsPresent Boolean  @default(false)
  sitemapFound  Boolean  @default(false)
  llmsTxt       Boolean  @default(false)
  /// Set when the sidecar could not complete the check at all; `results` is
  /// then the robots-only partial rather than a silent green.
  error         String?
  checkedAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, checkedAt])
  @@map("bot_access_checks")
}

enum BotLogStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

/// Bot Analytics — aggregates from one uploaded access log.
///
/// AGGREGATES ONLY, BY DESIGN. Access logs carry visitor IP addresses, which are
/// personal data we have no reason to hold: the worker parses the upload, writes
/// the counts below, and deletes the file. There is deliberately no column that
/// could hold a raw line or an IP, so a future "just keep a sample for
/// debugging" change has to add one and argue for it.
///
/// This is the ground-truth half of the tool. The access check says whether a
/// crawler COULD reach the site; only the logs say whether it DID.
model BotLogAnalysis {
  id           String       @id @default(cuid())
  tenantId     String
  /// Original upload name, for the history list. Never a path on disk.
  filename     String
  sizeBytes    Int
  status       BotLogStatus @default(PENDING)
  /// Human-readable reason when status is FAILED (unparseable, empty, too big).
  error        String?
  /// Detected from the log's own timestamps, not from the upload time.
  periodStart  DateTime?
  periodEnd    DateTime?
  linesParsed  Int          @default(0)
  linesSkipped Int          @default(0)
  botHits      Int          @default(0)
  /// { perBotPerDay, topPaths, statusSplit, firstLastSeen, verified } — counts
  /// and paths only. See src/lib/bot-analytics/log-parser.ts for the shape.
  aggregates   Json?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("bot_log_analyses")
}

/// Rank Tracker — a tracking project: one domain, a set of keywords, one
/// market, checked on a schedule. Keywords are checked through the SAME
/// DataForSEO standard queue as the SERP Checker ($0.0006/keyword); the shared
/// sweep in serp-check.worker.ts routes finished task ids to RankSnapshot.
///
/// `active=false` is a soft pause: the project and its history stay, but the
/// scheduler skips it. `overCap` is set BY THE SCHEDULER when a downgrade
/// leaves a project holding more keywords than its plan now allows — the run
/// is skipped rather than silently truncated, and the UI explains why.
model RankProject {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  domain       String // normalized: no scheme, no www., no path
  locationCode Int
  languageCode String
  device       String // desktop | mobile
  frequency    String // daily | weekly
  active       Boolean   @default(true)
  /// Scheduler-set: plan cap exceeded (e.g. after a downgrade). Blocks runs.
  overCap      Boolean   @default(false)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  keywords RankKeyword[]

  // Project list, newest first.
  @@index([tenantId, createdAt])
  // Scheduler sweep: active projects, cheapest possible scan.
  @@index([active, frequency])
}

/// One tracked keyword inside a project. Unique per project so re-submitting
/// the same textarea cannot create duplicates that would each cost $0.0006.
model RankKeyword {
  id        String   @id @default(cuid())
  projectId String
  keyword   String
  createdAt DateTime @default(now())

  project   RankProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots RankSnapshot[]

  @@unique([projectId, keyword])
  @@index([projectId])
}

/// One keyword, one run. `position` is null when the domain did not appear in
/// the top 100 — a real, meaningful result, NOT missing data, which is why the
/// column is nullable rather than defaulting to 0 or 101.
///
/// `status` mirrors SerpCheck's queue-status pattern: rows are written `queued`
/// at task_post time and completed by the shared sweep.
model RankSnapshot {
  id               String    @id @default(cuid())
  keywordId        String
  runDate          DateTime  @default(now())
  status           String    @default("queued") // queued | completed | failed
  position         Int? // null = not in the top 100
  url              String? // best-ranking URL for the tracked domain
  serpFeatures     Json? // string[] of non-organic element types present
  dataforseoTaskId String?   @unique
  costUsd          Decimal   @default(0) @db.Decimal(10, 6)
  error            String?
  completedAt      DateTime?

  keyword RankKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  // History chart + latest-position lookup for one keyword.
  @@index([keywordId, runDate])
  // Shared sweep: queued rows with a task id, oldest first.
  @@index([status, runDate])
}

/// Backlinks tool — one row per analysis. An analysis is FIVE live DataForSEO
/// Backlinks calls (summary, history, referring_domains, anchors, domain_pages)
/// run in sequence inside a single POST; the family has no standard queue, so
/// there is no worker and no `queued` state.
///
/// Sections are stored independently and `failedSections` names the ones that
/// did not come back: a partial analysis is worth keeping (and worth showing)
/// rather than discarding four good sections because one endpoint 500'd.
///
/// `mode` is part of the cache key, not decoration: "example.com" in domain
/// mode and "https://example.com/pricing" in exact-URL mode are different
/// questions with different answers and must never share a cached row.
model BacklinksAnalysis {
  id               String   @id @default(cuid())
  tenantId         String
  target           String // normalized: bare host (domain) or absolute URL (exact_url)
  mode             String // domain | exact_url
  status           String   @default("completed") // completed | partial
  costUsd          Decimal  @default(0) @db.Decimal(10, 6)
  summary          Json? // SummarySection — totals, rank, dofollow split
  history          Json? // HistorySection — monthly growth series
  referringDomains Json? // ReferringDomainsSection — top 50
  anchors          Json? // AnchorsSection — top 30 anchor texts
  pages            Json? // PagesSection — top 20 most-linked pages
  failedSections   Json? // string[] of section keys that did not load
  createdAt        DateTime @default(now())

  // Cache lookup: newest analysis for this exact target + mode.
  @@index([tenantId, target, mode, createdAt])
  // History list.
  @@index([tenantId, createdAt])
}

/// Content Explorer — one search for a phrase across DataForSEO's Content
/// Analysis index. A "search" is one or two live calls: search/live always, and
/// summary/live only when the first reports a non-zero total.
///
/// COST IS ~96% FIXED, which shapes this table. Measured Jul 2026: each call
/// bills $0.024036 regardless of how much it returns, plus roughly $0.0000353
/// per returned item — so a search that finds NOTHING costs $0.024 and a search
/// returning 50 rows costs $0.0258. That is why the row is persisted even when
/// it found zero mentions (re-running would cost the same again, so the empty
/// answer is worth caching) and why `summary` is nullable rather than assumed.
///
/// `costUsd` is the sum of the envelope `cost` fields for this search, never a
/// price-table estimate — see the note at the top of dataforseo/metering.ts.
model ContentSearch {
  id        String   @id @default(cuid())
  tenantId  String
  /// The phrase as searched: trimmed and lowercased, so the cache key and the
  /// history list do not treat "Echorank360" and "echorank360" as two searches.
  query     String
  /// The angle preset the query came from (brand | competitor | topic). Purely
  /// a UI label — every preset runs the identical code path.
  angle     String   @default("topic")
  /// { limit, offset, search_mode } as sent, so a stored row can be explained.
  params    Json
  /// content_analysis/search/live: total_count + the page items we kept.
  results   Json
  /// content_analysis/summary/live: totals, sentiment split, top domains,
  /// countries, languages. Null when the search found nothing — the summary
  /// endpoint returns all-zero fields for a zero-result phrase, so calling it
  /// would spend $0.024 to learn nothing.
  summary   Json?
  costUsd   Decimal  @default(0) @db.Decimal(10, 6)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Cache lookup: newest search for this exact phrase.
  @@index([tenantId, query, createdAt])
  // History list.
  @@index([tenantId, createdAt])
  @@map("content_searches")
}

/// Lighthouse tool — one row per audit. An audit is ONE PageSpeed Insights
/// call (Google's own Lighthouse runner), not DataForSEO, and it is free.
///
/// Mobile and desktop are separate audits, not two halves of one: Lighthouse
/// throttles them differently and they routinely differ by 30+ points, so
/// `strategy` is part of both the row identity and the 6 h cache key.
///
/// `crux` is nullable because most pages have no field data: CrUX only reports
/// URLs with enough real Chrome traffic. Null means "Google has no field data",
/// which the UI must say out loud rather than render as zeros.
model LighthouseAudit {
  id                String   @id @default(cuid())
  tenantId          String
  url               String // normalized absolute URL, fragment stripped
  strategy          String // mobile | desktop
  scores            Json // CategoryScores — performance/a11y/best-practices/seo
  metrics           Json // LabMetric[] — FCP, LCP, TBT, CLS, SI, TTI
  opportunities     Json // Opportunity[] — sorted by estimated saving
  crux              Json? // CruxData — null when the page has no field data
  /// Lighthouse version, so an odd score can be traced to a scoring change.
  lighthouseVersion String?
  fetchedAt         DateTime @default(now())

  // Cache lookup: newest audit for this exact URL + strategy.
  @@index([tenantId, url, strategy, fetchedAt])
  // History list.
  @@index([tenantId, fetchedAt])
}

/// Site Audit — one row per technical-SEO crawl of a domain.
///
/// DISTINCT FROM the audit on /visibility: that one measures AI-engine
/// readability (the AI Visibility product). This one is DataForSEO's OnPage
/// crawler checking classic technical SEO — broken links, duplicate titles,
/// 4xx/5xx, canonical and https problems. Both exist on purpose; the copy on
/// each page says so.
///
/// An ASYNC CRAWL, not a standard-queue task: OnPage is posted once and then
/// polled via on_page/summary/<taskId> until crawl_progress is "finished",
/// which can take minutes. `status` therefore has a real `crawling` state that
/// the UI polls, and the row is safe to leave and come back to.
///
/// Billed per page CRAWLED, so `maxPages` is the cost lever and is clamped to
/// the tenant's plan at start time.
model SiteAudit {
  id               String    @id @default(cuid())
  tenantId         String
  domain           String // normalized: no scheme, no www., no path
  maxPages         Int
  dataforseoTaskId String?   @unique
  status           String    @default("queued") // queued | crawling | completed | failed
  /// Pages crawled so far — drives the progress bar during the crawl.
  pagesCrawled     Int       @default(0)
  summary          Json? // SummarySection — onpage_score, page/request totals
  issues           Json? // IssuesSection — problem checks grouped by severity
  pages            Json? // PagesSection — worst pages, up to 100 rows
  costUsd          Decimal   @default(0) @db.Decimal(10, 6)
  error            String?
  createdAt        DateTime  @default(now())
  finishedAt       DateTime?

  // Cache lookup: newest audit for this domain.
  @@index([tenantId, domain, createdAt])
  // History list.
  @@index([tenantId, createdAt])
  // Poller sweep: unfinished rows with a task id, oldest first.
  @@index([status, createdAt])
}

enum GaConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
}

/// Web Analytics — one GA4 connection per tenant.
///
/// A SEPARATE token set from GscConnection rather than incremental scope on
/// it. The two integrations are independently connectable and disconnectable,
/// and widening the GSC token to carry analytics.readonly would mean
/// disconnecting Search Console also killed Analytics. Same shape, same
/// crypto (lib/gsc/crypto.ts), same 401 -> retry -> NEEDS_REAUTH contract.
///
/// No report data is stored: GA4 already holds the history, so reports are
/// queried live and cached in Redis for an hour. This row is the whole
/// persistence footprint of the feature.
model GaConnection {
  id              String             @id @default(cuid())
  tenantId        String             @unique
  /// v1:<iv>:<tag>:<ciphertext> (base64url segments), same format as GSC.
  refreshTokenEnc String
  /// Chosen GA4 property, "properties/123456789"; null until picked.
  propertyId      String?
  /// Human label for the picked property, so the UI need not re-query.
  propertyName    String?
  status          GaConnectionStatus @default(ACTIVE)
  connectedAt     DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ga_connections")
}

/// Page HTML snapshots over time — the storage half of the Historical tool.
///
/// METADATA ONLY. The gzipped markdown body lives in DigitalOcean Spaces at
/// `snapshots/<tenantId>/<sha256>.md.gz`, private ACL, streamed back through an
/// authenticated route. AiLensAnalysis deliberately does not persist its
/// markdown ("hundreds of KB per row... would make the table the largest in the
/// database within a month") — that reasoning is why the body is in object
/// storage rather than a bytea column here.
///
/// Dedupe is by contentHash: an unchanged page re-captured writes no new row and
/// uploads no new object.
model PageSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  url         String
  /// The moment the CONTENT is from, not the moment we stored it. For a Wayback
  /// import this is the archive's own timestamp, which is the whole point of
  /// backfilling — a row stamped `now()` would put 2019 content on today.
  capturedAt  DateTime
  /// sha256 of the markdown, hex. Dedupe key and the object name.
  contentHash String
  /// Spaces object key. Several rows may share one object (same content at
  /// different URLs or times), so objects are deleted only when the last
  /// referencing row goes.
  objectKey   String
  sizeBytes   Int
  /// ai_lens | manual | wayback
  source      String
  createdAt   DateTime @default(now())

  @@index([tenantId, url, capturedAt])
  /// Dedupe lookup, and the reference count that guards object deletion.
  @@index([tenantId, contentHash])
  @@map("page_snapshots")
}
