generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum PlanType {
  AI_VISIBILITY
  STARTER
  GROWTH
  AGENCY
  ENTERPRISE
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum FeedbackStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

enum CustomerStatus {
  NEW
  CONTACTED
  SATISFIED
  NEEDS_FOLLOWUP
  RECOVERED
  LOST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  passwordHash    String?
  termsAcceptedAt DateTime?
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     TenantMember[]
  accounts        Account[]
  sessions        Session[]
  auditLogs       AuditLog[]
  extensionTokens ExtensionToken[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Tenant {
  id                    String        @id @default(cuid())
  name                  String
  slug                  String        @unique
  logo                  String?
  brandPrimaryColor     String        @default("#2563eb")
  brandSecondaryColor   String        @default("#1e40af")
  supportEmail          String?
  googleReviewLink      String?
  facebookReviewLink    String?
  trustpilotLink        String?
  defaultLanguage       String        @default("en")
  timezone              String        @default("America/New_York")
  planType              PlanType      @default(STARTER)
  monthlyRequestLimit   Int           @default(300)
  billingStatus         BillingStatus @default(TRIALING)
  /// Marketing Studio brand voice, produced by category 08's heuristic and
  /// saved by the tenant. Prepended to every generation's system prompt when
  /// set. Text, not JSON: it is written straight into a prompt.
  brandVoiceGuide       String?       @map("brand_voice_guide") @db.Text
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  whitelabel            Boolean       @default(false)
  customDomain          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  welcomeSeenAt         DateTime?
  onboardingDismissedAt DateTime?
  onboardingIntent      String? // "business" | "agency"
  auditDomain           String? // domain captured from the landing audit widget or the welcome modal
  // Explicit domain for Bot Analytics, set on the tool page itself. Separate
  // from auditDomain so the tool is self-sufficient for a tenant that never ran
  // an AI Visibility audit, and so overriding it here cannot disturb onboarding.
  botAnalyticsDomain    String?
  onboarding            Json? // { pdfDownloadedAt?, roadmapViewedAt?, firstAuditScore?, firstAuditAt?, profileCompletedAt? }
  marketingConsent      Boolean       @default(true)

  members            TenantMember[]
  visibilityMonitors VisibilityMonitor[]
  visibilityAudits   VisibilityAudit[]
  trackedPrompts     TrackedPrompt[]
  promptRuns         PromptRun[]
  customers          Customer[]
  feedback           Feedback[]
  reviewLinks        ReviewLink[]
  emailTemplates     EmailTemplate[]
  smsTemplates       SmsTemplate[]
  recoveryTickets    RecoveryTicket[]
  emailLogs          EmailLog[]
  smsLogs            SmsLog[]
  campaigns          Campaign[]
  subscription       Subscription?
  auditLogs          AuditLog[]
  domainEvents       DomainEvent[]
  usageMeters        UsageMeter[]
  usageSnapshots     UsageSnapshot[]
  quota              TenantQuota?
  retentionPolicy    DataRetentionPolicy?
  deletionLogs       DeletionLog[]
  reputationScores   ReputationScore[]
  aiAnalyses         AiAnalysis[]
  escalationAlerts   EscalationAlert[]
  notifications      Notification[]
  monitoringSources  MonitoringSource[]
  externalReviews    ExternalReview[]
  importJobs         ImportJob[]
  extensionTokens    ExtensionToken[]
  apiKeys            ApiKey[]
  attributionKeys    AttributionKey[]
  aiVisits           AiVisit[]
  gscConnection      GscConnection?
  gaConnection       GaConnection?
  gscQueryStats      GscQueryStat[]
  aiLensAnalyses     AiLensAnalysis[]
  botAccessChecks    BotAccessCheck[]
  botLogAnalyses     BotLogAnalysis[]
  contentSearches    ContentSearch[]

  crawlJobs CrawlJob[]

  brandProfiles   BrandProfile[]
  checkups        Checkup[]
  aiProviderCalls AiProviderCall[]

  citations            Citation[]
  competitorMentions   CompetitorMention[]
  sources              Source[]
  citationOpportunities CitationOpportunity[]
  recommendations      Recommendation[]
  experiments          Experiment[]
  sovSnapshots         SovSnapshot[]
  explainReports       ExplainReport[]
  scanBatches          ScanBatch[]

  @@map("tenants")
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

model Customer {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  email           String?
  phone           String?
  status          CustomerStatus   @default(NEW)
  tags            String[]
  location        String?
  metadata        Json?
  deletedAt       DateTime?
  archivedAt      DateTime?
  legalHold       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback        Feedback[]
  emailLogs       EmailLog[]
  smsLogs         SmsLog[]
  recoveryTickets RecoveryTicket[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@map("customers")
}

model Feedback {
  id             String          @id @default(cuid())
  tenantId       String
  customerId     String
  campaignId     String?
  rating         Int?
  comment        String?
  status         FeedbackStatus  @default(PENDING)
  token          String          @unique
  submittedAt    DateTime?
  routedAt       DateTime?
  expiresAt      DateTime?
  deletedAt      DateTime?
  legalHold      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id])
  reviewRequest  ReviewRequest?
  recoveryTicket RecoveryTicket?

  @@index([tenantId])
  @@index([token])
  @@index([tenantId, status])
  @@index([tenantId, rating])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, campaignId])
  @@index([status, routedAt])
  @@map("feedback")
}

model ReviewLink {
  id        String   @id @default(cuid())
  tenantId  String
  platform  String
  url       String
  label     String?
  location  String?
  isDefault Boolean  @default(false)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("review_links")
}

model ReviewRequest {
  id         String    @id @default(cuid())
  feedbackId String    @unique
  platform   String
  url        String
  clicked    Boolean   @default(false)
  clickedAt  DateTime?
  sentAt     DateTime  @default(now())
  feedback   Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("review_requests")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  body      String
  type      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("email_templates")
}

model SmsTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  body      String
  type      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sms_templates")
}

model RecoveryTicket {
  id         String         @id @default(cuid())
  tenantId   String
  customerId String
  feedbackId String         @unique
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  assignedTo String?
  notes      String?
  resolvedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, createdAt])
  @@map("recovery_tickets")
}

model EmailLog {
  id                String         @id @default(cuid())
  tenantId          String
  customerId        String
  to                String
  subject           String
  body              String
  status            MessageStatus  @default(QUEUED)
  channel           MessageChannel @default(EMAIL)
  // Brevo's message-id (Message-Id header it assigns at relay time). Captured
  // at send for debugging/joins. NOTE: Brevo's SMTP relay rewrites Message-Id,
  // so this is NOT a reliable webhook-correlation key on its own — webhook
  // correlation uses the X-Mailin-custom token carrying this row's id instead.
  providerMessageId String?
  // Lifecycle timestamps populated by Brevo webhook events.
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime       @default(now())
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([customerId, tenantId])
  @@index([providerMessageId])
  @@map("email_logs")
}

model SmsLog {
  id                String        @id @default(cuid())
  tenantId          String
  customerId        String
  to                String
  body              String
  status            MessageStatus @default(QUEUED)
  // Brevo SMS message-id returned by the send API. Unlike email, the SMS API
  // response id matches the webhook's message id, so this IS the correlation key.
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([providerMessageId])
  @@map("sms_logs")
}

model Campaign {
  id             String         @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  channel        MessageChannel @default(EMAIL)
  status         CampaignStatus @default(DRAFT)
  location       String?
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  totalSent      Int            @default(0)
  totalResponses Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback       Feedback[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("campaigns")
}

/// What a subscription is for.
///
/// Subscription.tenantId is UNIQUE, so a tenant gets one row. A standalone
/// watcher purchase therefore occupies the same row a plan would, and without
/// this column it is indistinguishable from a plan: the webhook resolves a
/// PlanType from the price and falls back to the tenant's existing planType
/// when it cannot, so a $9 watcher would have written an ACTIVE row carrying
/// whatever tier the tenant defaulted to — and requirePaidPlan, which asks only
/// "ACTIVE, with a row?", would have granted every paid tool in the product.
enum ProductKind {
  PLAN
  WATCHER
}

model Subscription {
  id                   String        @id @default(cuid())
  tenantId             String        @unique
  planType             PlanType
  /// PLAN by default: every row that existed before the standalone watcher was
  /// sold is a plan, and a default of WATCHER would strip existing paying
  /// customers of everything on the next request.
  productKind          ProductKind   @default(PLAN)
  status               BillingStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  stripeSubscriptionId String?
  stripePriceId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entity])
  @@map("audit_logs")
}

// ─── PHASE 2: Domain Events ────────────────────────────────────────────

enum DomainEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model DomainEvent {
  id            String            @id @default(cuid())
  tenantId      String
  eventType     String
  eventVersion  Int               @default(1)
  aggregateType String
  aggregateId   String
  payload       Json
  metadata      Json?
  status        DomainEventStatus @default(PENDING)
  correlationId String?
  causationId   String?
  retryCount    Int               @default(0)
  maxRetries    Int               @default(3)
  processedAt   DateTime?
  failedAt      DateTime?
  error         String?
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventType, aggregateId, correlationId], name: "event_idempotency_key")
  @@index([tenantId])
  @@index([eventType])
  @@index([status])
  @@index([correlationId])
  @@index([createdAt])
  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
  @@map("domain_events")
}

// ─── PHASE 4: Usage Metering ───────────────────────────────────────────

enum MeterType {
  EMAIL_SENT
  SMS_SENT
  WEBHOOK_CALL
  API_REQUEST
  AI_TOKEN_USAGE
  AI_INFERENCE
  REVIEW_CONVERSION
  ESCALATION_EVENT
  FEEDBACK_REQUEST
  MONITORING_CHECK
}

model UsageMeter {
  id         String    @id @default(cuid())
  tenantId   String
  meterType  MeterType
  quantity   Int       @default(1)
  unitCost   Float     @default(0)
  metadata   Json?
  recordedAt DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, meterType])
  @@index([tenantId, recordedAt])
  @@map("usage_meters")
}

model UsageSnapshot {
  id                String   @id @default(cuid())
  tenantId          String
  periodStart       DateTime
  periodEnd         DateTime
  emailsSent        Int      @default(0)
  smsSent           Int      @default(0)
  webhookCalls      Int      @default(0)
  apiRequests       Int      @default(0)
  aiTokensUsed      Int      @default(0)
  aiInferences      Int      @default(0)
  aiCost            Float    @default(0)
  feedbackRequests  Int      @default(0)
  reviewConversions Int      @default(0)
  escalationEvents  Int      @default(0)
  monitoringChecks  Int      @default(0)
  totalCost         Float    @default(0)
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId])
  @@map("usage_snapshots")
}

model TenantQuota {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  maxEmailsPerMonth       Int      @default(300)
  maxSmsPerMonth          Int      @default(0)
  maxWebhooksPerMonth     Int      @default(1000)
  maxApiRequestsPerDay    Int      @default(10000)
  maxAiInferencesPerMonth Int      @default(100)
  maxMonitoringChecks     Int      @default(0)
  overageAllowed          Boolean  @default(false)
  overageRateEmail        Float    @default(0.01)
  overageRateSms          Float    @default(0.05)
  overageRateAi           Float    @default(0.02)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_quotas")
}

// ─── PHASE 5: Soft Delete & Compliance ─────────────────────────────────

model DataRetentionPolicy {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  feedbackRetentionDays Int      @default(730)
  customerRetentionDays Int      @default(1095)
  auditLogRetentionDays Int      @default(2555)
  eventRetentionDays    Int      @default(365)
  autoDeleteEnabled     Boolean  @default(false)
  gdprCompliant         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("data_retention_policies")
}

model DeletionLog {
  id           String    @id @default(cuid())
  tenantId     String
  entityType   String
  entityId     String
  deletedBy    String?
  reason       String?
  legalHold    Boolean   @default(false)
  restorable   Boolean   @default(true)
  snapshotData Json?
  deletedAt    DateTime  @default(now())
  expiresAt    DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("deletion_logs")
}

// ─── PHASE 6: AI Reputation Intelligence ───────────────────────────────

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model ReputationScore {
  id                  String    @id @default(cuid())
  tenantId            String
  location            String?
  overallScore        Float
  sentimentScore      Float
  responseRateScore   Float
  recoveryScore       Float
  reviewVelocityScore Float
  volatilityIndex     Float     @default(0)
  riskLevel           RiskLevel @default(LOW)
  trendDirection      String    @default("stable")
  periodStart         DateTime
  periodEnd           DateTime
  sampleSize          Int       @default(0)
  confidence          Float     @default(0)
  createdAt           DateTime  @default(now())
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, location])
  @@index([tenantId, createdAt])
  @@map("reputation_scores")
}

model AiAnalysis {
  id                    String    @id @default(cuid())
  tenantId              String
  feedbackId            String?
  externalReviewId      String?
  analysisType          String
  sentimentLabel        String?
  sentimentScore        Float?
  escalationProbability Float?
  publicPostProbability Float?
  churnProbability      Float?
  riskLevel             RiskLevel @default(LOW)
  intent                String?
  entities              Json?
  emotions              Json?
  topics                Json?
  suggestedAction       String?
  confidence            Float     @default(0)
  modelId               String?
  promptTokens          Int       @default(0)
  completionTokens      Int       @default(0)
  latencyMs             Int       @default(0)
  createdAt             DateTime  @default(now())
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([feedbackId])
  @@index([analysisType])
  @@index([riskLevel])
  @@index([tenantId, createdAt])
  @@map("ai_analyses")
}

model EscalationAlert {
  id               String    @id @default(cuid())
  tenantId         String
  customerId       String?
  feedbackId       String?
  externalReviewId String?
  alertType        String
  riskLevel        RiskLevel
  probability      Float
  title            String
  description      String
  suggestedAction  String?
  acknowledged     Boolean   @default(false)
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, riskLevel])
  @@index([tenantId, acknowledged])
  @@map("escalation_alerts")
}

// ─── PHASE 7: External Reputation Monitoring ───────────────────────────

enum MonitoringPlatform {
  GOOGLE
  FACEBOOK
  TRUSTPILOT
  YELP
  REDDIT
  TWITTER
  TIKTOK
  YOUTUBE
  APP_STORE
  CUSTOM
}

model MonitoringSource {
  id            String             @id @default(cuid())
  tenantId      String
  platform      MonitoringPlatform
  externalId    String
  name          String
  url           String?
  credentials   Json?
  isActive      Boolean            @default(true)
  lastCheckedAt DateTime?
  checkInterval Int                @default(3600)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews       ExternalReview[]
  importJobs    ImportJob[]

  @@unique([tenantId, platform, externalId])
  @@index([tenantId])
  @@map("monitoring_sources")
}

model ExternalReview {
  id               String             @id @default(cuid())
  tenantId         String
  sourceId         String
  platform         MonitoringPlatform
  externalId       String
  authorName       String?
  authorUrl        String?
  rating           Float?
  content          String?
  language         String?
  publishedAt      DateTime?
  url              String?
  replyContent     String?
  repliedAt        DateTime?
  sentimentLabel   String?
  sentimentScore   Float?
  riskLevel        RiskLevel          @default(LOW)
  isProcessed      Boolean            @default(false)
  deduplicationKey String             @unique
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source           MonitoringSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, platform])
  @@index([tenantId, riskLevel])
  @@index([sourceId])
  @@index([publishedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, sentimentLabel])
  @@map("external_reviews")
}

// ─── PHASE 3: Observability ────────────────────────────────────────────

model SystemMetric {
  id         String   @id @default(cuid())
  tenantId   String?
  metricName String
  value      Float
  tags       Json?
  recordedAt DateTime @default(now())

  @@index([metricName, recordedAt])
  @@index([tenantId, metricName])
  @@map("system_metrics")
}

// ─── Processed Webhooks (Stripe idempotency) ──────────────────────────

model ProcessedWebhook {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())
  payload       Json?

  @@index([eventType])
  @@map("processed_webhooks")
}

// ─── Brevo (email/SMS) webhook events ─────────────────────────────────
// Brevo does not send a unique event id (unlike Stripe), so idempotency is
// enforced via a deterministic dedup key derived from the message id, event
// type, and event timestamp. The unique constraint makes replays no-ops, the
// same way ProcessedWebhook.stripeEventId does for Stripe.
model MessageEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  channel    String // EMAIL | SMS
  event      String // delivered | opened | click | hard_bounce | ...
  recipient  String?
  messageId  String?
  emailLogId String?
  smsLogId   String?
  dedupeKey  String   @unique
  payload    Json?
  occurredAt DateTime
  receivedAt DateTime @default(now())

  @@index([tenantId])
  @@index([emailLogId])
  @@index([smsLogId])
  @@index([event])
  @@map("message_events")
}

// ─── Stripe multi-currency price catalog ───────────────────────────────
// One Stripe Price object exists per (tier, currency, interval). Rather than
// fanning these out as env vars (4 tiers x 5 currencies = 20), they are
// resolved from this table at checkout/webhook time. `active` lets old prices
// be retired without deletion; lookups always filter on active = true.
/// One row per SUCCESSFUL Anthropic call from Marketing Studio.
///
/// Heuristic-only work writes nothing here — it costs nothing, so metering it
/// would overstate spend and make the monthly budget deny work that was free.
/// Cache-served results write nothing either, for the same reason.
model AiApiCall {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  categoryId      String   @map("category_id")
  model           String
  inputTokens     Int      @default(0) @map("input_tokens")
  outputTokens    Int      @default(0) @map("output_tokens")
  /// From the API usage block. Expected to stay 0 on Haiku 4.5 — the shared
  /// prefix is ~500 tokens against a 4096-token minimum, so nothing caches.
  /// Recorded anyway so the assumption is measurable rather than asserted.
  cacheReadTokens Int      @default(0) @map("cache_read_tokens")
  createdAt       DateTime @default(now()) @map("created_at")

  /// The budget query is "output tokens for this tenant this month".
  @@index([tenantId, createdAt])
  @@map("ai_api_calls")
}

model StripePrice {
  id            String   @id @default(cuid())
  stripePriceId String   @unique @map("stripe_price_id")
  planTier      String   @map("plan_tier") // starter | growth | agency | enterprise
  currency      String // USD | EUR | GBP | CAD | CHF
  interval      String   @default("month") // month | year
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([planTier, currency, interval, active])
  @@map("stripe_prices")
}

// ─── Soft Delete Additions to Existing Models ──────────────────────────
// Note: deletedAt, archivedAt, legalHold fields are added to core models
// via the compliance middleware layer rather than schema changes, to avoid
// breaking the existing API. The DeletionLog table tracks all deletions.

// ─── CSV / file import jobs ────────────────────────────────────────────
// A multi-source ingestion record. Reviews uploaded via CSV (and, later,
// Excel/Sheets/Airtable) are attached to a synthetic MonitoringSource so they
// flow through the exact same normalize → dedup → AiAnalysis → reputation /
// escalation pipeline as platform-monitored reviews. This table is the import
// history + column-mapping wizard state machine, and (for v1) the staging
// store for the raw uploaded text between the preview and commit steps.
enum ImportStatus {
  PENDING_MAPPING // uploaded + parsed headers; awaiting column-mapping confirmation
  QUEUED // mapping confirmed; csv-import job enqueued
  PROCESSING // worker is ingesting rows
  COMPLETED // all rows ingested (some may have been duplicates)
  PARTIAL // completed, but one or more rows failed validation
  FAILED // job-level failure (parse error, etc.)
  CANCELLED // user discarded before commit
}

enum ImportSourceFormat {
  GENERIC_CSV
  GOOGLE_CSV
  FACEBOOK_CSV
  TRUSTPILOT_CSV
  EXCEL // reserved for the .xlsx slice (Feature 4); parsed to rows then shares this pipeline
  EXTENSION // browser-extension scraped import; rows arrive pre-structured as JSON
}

model ImportJob {
  id              String             @id @default(cuid())
  tenantId        String
  // The synthetic MonitoringSource these rows are attached to. Nullable so a
  // discarded (CANCELLED) or failed-at-parse import need not allocate a source.
  sourceId        String?
  filename        String
  format          ImportSourceFormat @default(GENERIC_CSV)
  // Platform the rows represent — drives the dedup namespace and dashboards.
  platform        MonitoringPlatform @default(CUSTOM)
  status          ImportStatus       @default(PENDING_MAPPING)
  // Raw uploaded text, retained for re-parse at commit time. Capped at the
  // route layer (see MAX_IMPORT_BYTES). For very large files this should move
  // to object storage; kept in-row for v1 since review exports are small.
  rawContent      String?            @db.Text
  hasHeaderRow    Boolean            @default(true)
  // Header names detected at parse time: string[].
  detectedColumns Json?
  // Confirmed mapping of canonical field -> source column, e.g.
  // { "rating": "Star Rating", "content": "Review", "author": "Name" }.
  columnMapping   Json?
  totalRows       Int                @default(0)
  importedRows    Int                @default(0)
  duplicateRows   Int                @default(0)
  failedRows      Int                @default(0)
  // Up to N row-level errors: [{ row: number, message: string }].
  errors          Json?
  errorMessage    String? // job-level failure reason
  createdById     String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source MonitoringSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([sourceId])
  @@map("import_jobs")
}

/// Long-lived API token issued to a logged-in user for the browser extension.
/// Only a SHA-256 hash of the secret is stored; the plaintext is shown once at
/// creation. Tokens are tenant-scoped, revocable, and rotatable (rotation =
/// revoke old + issue new, preserving label/scopes).
model ExtensionToken {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  /// Human label set at creation, e.g. "Chrome on work laptop".
  label      String
  /// SHA-256 (hex) of the token secret. Never store plaintext.
  tokenHash  String    @unique
  /// First 8 chars of the public token id, surfaced in the UI for identification.
  prefix     String
  /// Reserved for future per-token scoping (e.g. ["import:write"]).
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  /// Optional hard expiry. Null = no expiry (revoke to disable).
  expiresAt  DateTime?
  /// Set when revoked; a non-null value disables the token.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tokenHash])
  @@map("extension_tokens")
}

enum VisibilityCadence {
  DAILY
  WEEKLY
}

model VisibilityMonitor {
  id        String            @id @default(cuid())
  tenantId  String
  url       String
  cadence   VisibilityCadence @default(WEEKLY)
  active    Boolean           @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime          @default(now())
  // Snapshot of the last completed audit for cheap diffing + list views.
  lastScore Int?
  lastGrade String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audits VisibilityAudit[]

  @@unique([tenantId, url])
  @@index([active, nextRunAt])
  @@map("visibility_monitors")
}

model VisibilityAudit {
  id        String   @id @default(cuid())
  tenantId  String
  monitorId String?
  url       String
  score     Int
  grade     String
  // checks[] and robots.bots snapshots from the sidecar, for diffing + trend UI.
  checks    Json
  bots      Json
  raw       Json?
  createdAt DateTime @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  monitor VisibilityMonitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([monitorId, createdAt])
  @@map("visibility_audits")
}

model TrackedPrompt {
  id        String    @id @default(cuid())
  tenantId  String
  text      String
  active    Boolean   @default(true)
  /// Least-recently-run ordering is what rotates prompts across checkups when
  /// a brand selects more than its tier's per-checkup cap allows.
  lastRunAt DateTime?
  nextRunAt DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // ── Setup wizard (nullable: prompts predating the wizard have none) ──
  /// Null until a brand profile exists; the wizard sets it.
  brandProfileId  String?
  /// DISCOVERY | RECOMMENDATION | COMPARISON | ALTERNATIVES | PRICING |
  /// USE_CASE | FEATURES | TRUST | PURCHASE | BRAND_AWARENESS
  category        String?
  /// commercial | research | navigational
  intent          String?
  audience        String?
  market          String?
  language        String?       @default("en")
  source          PromptSource?
  /// ISO-3166-1 alpha-2, for provider calls that take a location. `market` is
  /// the free-text label the wizard renders; this is the machine-readable one.
  country         String?
  /// 0-100, deterministic. Null for prompts that predate the scorer.
  relevanceScore  Int?
  /// Free-text labels a user puts on a prompt to group it — "brand", "EU",
  /// "launch". The ONLY writable field on a prompt besides `active`, and
  /// deliberately unvalidated: a taxonomy nobody chose is a taxonomy nobody
  /// uses, and these are for the customer's own filtering rather than for any
  /// query this product runs.
  tags            String[]      @default([])
  /// 0-100. The score that ORDERED THE WIZARD'S SUGGESTIONS when this prompt
  /// was proposed — see suggestionScore() in wizard/scoring.ts. Null for a
  /// prompt the user wrote themselves, which was never ranked against anything.
  ///
  /// NOT `importanceScore`, deliberately: `importanceWeight` below is a
  /// customer-set multiplier on this prompt's contribution to the rolled-up
  /// score, and two fields called importance* on one row is how someone
  /// autocompletes into the wrong one. Distinct from `relevanceScore` too —
  /// that asks whether the question is about this brand, this asks which
  /// twenty of forty candidates a new customer should start with.
  suggestionScore Int?
  /// Chosen in the wizard. `active` stays the tracking switch; this is the
  /// wizard's own selection state, so deselecting in the wizard and pausing
  /// tracking remain different actions.
  selected        Boolean       @default(false)

  /// 0-100. How much money sits behind this question, judged at discovery time
  /// from intent plus (where available) search demand. DISTINCT FROM
  /// relevanceScore, which asks whether the question is about this brand at
  /// all: "best free CRM" is highly relevant to a CRM vendor and commercially
  /// weak, and collapsing the two would rank the freebie hunters top.
  commercialValue   Int?
  /// Multiplier on this prompt's contribution to the brand's rolled-up
  /// visibility. Defaults to 1 — a prompt counts once until someone says
  /// otherwise. Lets a brand weight its two flagship questions above the
  /// eighteen long-tail ones without deleting the long tail.
  importanceWeight  Float           @default(1)
  /// How often the scheduler asks this prompt. Raised automatically when a
  /// prompt turns out to be volatile (Phase 5) — an answer that changes daily
  /// has to be sampled daily or the trend line is noise.
  trackingFrequency PromptFrequency @default(WEEKLY)

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandProfile    BrandProfile?    @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  runs            PromptRun[]
  recommendations Recommendation[]
  experiments     Experiment[]

  @@unique([tenantId, text])
  @@index([active, nextRunAt])
  @@index([brandProfileId, selected])
  /// Scheduler read: what is due, cheapest first.
  @@index([active, trackingFrequency, nextRunAt])
  @@map("tracked_prompts")
}

model PromptRun {
  id             String   @id @default(cuid())
  tenantId       String
  promptId       String
  engine         String   @default("claude")
  model          String
  brandMentioned Boolean
  brandRank      Int?
  // [{name, mentioned}] snapshot at run time.
  competitors    Json
  excerpt        String?  @db.Text
  error          String?
  createdAt      DateTime @default(now())

  /// Null for runs from the pre-checkup scheduler, which still writes here.
  checkupId  String?
  /// Which repetition this is, 1-based. Repeatability compares runs that share
  /// (checkup, prompt, provider) and differ only by this. This is the
  /// `run_number` half of the runner's idempotency key.
  repetition Int       @default(1)
  /// How this run ended. Defaults to OK so the 66 pre-checkup rows, which were
  /// all answered, keep meaning what they meant.
  status     RunStatus @default(OK)

  /// The answer exactly as the provider returned it. `excerpt` predates this
  /// and stays: it is the short form the list views render without pulling a
  /// multi-kilobyte column across the wire.
  rawResponse        String? @db.Text
  /// Whitespace-collapsed, markdown-stripped. What the hash and the analysis
  /// passes read, so that a provider reflowing its own formatting does not
  /// register as a changed answer.
  normalizedResponse String? @db.Text
  /// SHA-256 of normalizedResponse. Change detection compares this run to the
  /// previous one for the same (prompt, engine): equal hash, nothing moved,
  /// and the trend worker can skip the comparison entirely.
  responseHash       String?
  /// Wall-clock milliseconds for the provider call.
  latencyMs          Int?
  inputTokens        Int     @default(0)
  outputTokens       Int     @default(0)
  cachedInputTokens  Int     @default(0)
  /// USD for this run's answer call. DERIVED AT WRITE TIME from the tokens, by
  /// the same pricing table AiProviderCall uses — see the note there on why a
  /// stored cost must never be recomputed from a later price list. The
  /// AiProviderCall row remains the ledger; this is the per-run attribution.
  costUsd            Decimal @default(0) @db.Decimal(10, 6)

  /// Phase 8. Null means the project's own market and no persona wrapper —
  /// which is the baseline every geo/persona comparison is measured against,
  /// so it must stay distinguishable from "we asked as a consumer in Paris".
  location String?
  persona  String?

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prompt             TrackedPrompt       @relation(fields: [promptId], references: [id], onDelete: Cascade)
  checkup            Checkup?            @relation(fields: [checkupId], references: [id], onDelete: Cascade)
  analysis           MentionAnalysis?
  citations          Citation[]
  competitorMentions CompetitorMention[]

  /// THE RUNNER'S IDEMPOTENCY KEY. Re-running a checkup id must not double its
  /// runs, and the only defence that survives two workers racing on the same
  /// job is the database refusing the second write — a read-then-write check in
  /// the runner cannot.
  ///
  /// Safe despite `checkupId` being nullable: Postgres treats NULLs as distinct
  /// in a unique index, so the 66 pre-checkup rows (every one of them with a
  /// null checkupId) cannot collide with each other or with anything the runner
  /// writes. Verified against the table before this was added.
  @@unique([checkupId, promptId, engine, repetition])
  @@index([tenantId, createdAt])
  @@index([promptId, createdAt])
  /// Dashboard read: one checkup's responses, grouped by provider.
  @@index([checkupId, engine])
  /// Change detection: the previous run of this prompt on this engine.
  @@index([promptId, engine, createdAt])
  @@map("prompt_runs")
}

// ─────────────────────────────────────────────────────────────
// SIGNAL SPINE — paste these two models into prisma/schema.prisma
// then: npx prisma db push  (or use prisma/migration.sql manually)
// If your tenant FK convention is different (e.g. organizationId),
// find/replace `tenantId` here AND in src/lib/signals/*.
// ─────────────────────────────────────────────────────────────

model Signal {
  id         String   @id @default(cuid())
  tenantId   String
  source     String // review | feedback | visibility | support | social | news | competitor | manual
  externalId String? // stable id in the source system (review id, audit id…)
  dedupeHash String   @unique
  entityType String? // location | customer | …
  entityId   String?
  occurredAt DateTime
  ingestedAt DateTime @default(now())
  sentiment  Float // -1..1
  severity   Float // 0..1
  magnitude  Float    @default(0.5) // 0..1 reach/weight of the signal
  title      String?
  body       String?  @db.Text
  url        String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, source, occurredAt(sort: Desc)])
}

model RiskSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  day         DateTime @db.Date
  score       Int // 0..100, higher = more risk
  grade       String // A..F
  components  Json
  drivers     Json
  signalCount Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, day])
  @@index([tenantId, day(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// PHASE 2 — AlertEvent + TenantRiskConfig
// deploy-phase2.sh appends this automatically (with backup).
// ─────────────────────────────────────────────────────────────

model AlertEvent {
  id         String    @id @default(cuid())
  tenantId   String
  kind       String // risk_threshold | risk_spike | critical_signal
  severity   String // warning | critical
  title      String
  body       String?
  dedupeKey  String    @unique
  payload    Json?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([notifiedAt, createdAt])
}

model TenantRiskConfig {
  tenantId       String   @id
  monthlyRevenue Float?
  currency       String   @default("USD")
  riskElasticity Float    @default(0.10)
  alertEmails    String? // comma-separated; falls back to ALERT_FALLBACK_EMAIL
  alertsEnabled  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// PHASE 3 — Competitor + CompetitorSnapshot
// deploy-phase3.sh appends this automatically (with backup).
// ─────────────────────────────────────────────────────────────

model Competitor {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  placeId   String? // Google Places (v1) id → automated daily snapshots
  address   String? // formatted address / vicinity — disambiguates chains
  platform  String   @default("google")
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots CompetitorSnapshot[]

  @@unique([tenantId, placeId])
  @@index([tenantId, active])
}

model CompetitorSnapshot {
  id           String   @id @default(cuid())
  competitorId String
  day          DateTime @db.Date
  rating       Float?
  reviewCount  Int?
  raw          Json?
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, day])
  @@index([competitorId, day(sort: Desc)])
}

/// Tenant-scoped public-API keys (SEO Tools "API access"). Mirrors the
/// ExtensionToken design: opaque bearer `er_api_<id>.<secret>`, SHA-256 of
/// the secret stored (never plaintext), instant revocation via revokedAt.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  /// Human label set at creation, e.g. "CI pipeline".
  label      String
  /// SHA-256 (hex) of the secret segment. Never store plaintext.
  keyHash    String    @unique
  /// First 8 chars of the public id segment, surfaced for identification.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

/// Google Search Console connection (SEO Tools "GSC Insights"). One per
/// tenant. The OAuth refresh token is stored AES-256-GCM-encrypted
/// (src/lib/gsc/crypto.ts, key derived from GSC_TOKEN_ENCRYPTION_KEY) —
/// never in plaintext, never logged.
model GscConnection {
  id              String              @id @default(cuid())
  tenantId        String              @unique
  /// v1:<iv>:<tag>:<ciphertext> (base64url segments)
  refreshTokenEnc String
  googleEmail     String?
  /// Chosen GSC property (e.g. "sc-domain:example.com"); null until picked.
  siteUrl         String?
  status          GscConnectionStatus @default(ACTIVE)
  connectedAt     DateTime            @default(now())
  lastSyncAt      DateTime?
  /// Rows the last sync stored. lastSyncAt alone cannot tell "the sync ran and
  /// saved rows" apart from "the sync ran and saved none" — and the second is
  /// the normal outcome on a low-traffic property, where Google withholds
  /// queries below its anonymity threshold. Null means never synced.
  lastRowsSynced  Int?
  updatedAt       DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("gsc_connections")
}

enum GscConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
}

/// Daily query-level Search Console rows (nightly sync + manual sync). The
/// Rank Tracker foundation: page = "" marks the query-only aggregate row —
/// an empty-string sentinel rather than NULL so the composite unique key
/// works (Postgres treats NULLs as distinct in unique constraints).
model GscQueryStat {
  id          String   @id @default(cuid())
  tenantId    String
  siteUrl     String
  date        DateTime @db.Date
  query       String
  page        String   @default("")
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, query, page])
  @@index([tenantId, query, date])
  @@index([tenantId, date])
  @@map("gsc_query_stats")
}

// -----------------------------------------------------------------------------
// Classic SEO Tools — Phase 0 models (metering + caches).
// NOTE: migration history is unreplayable (docs/agents/BLOCKERS.md §5) —
// use `prisma migrate diff` + `migrate deploy`, not `migrate dev`.
// -----------------------------------------------------------------------------

/// One billed DataForSEO call. Carries TWO different aggregates, and conflating
/// them is the mistake this comment exists to prevent:
///
///   SPEND  — SUM(costUsd) WHERE ok, over the calendar month. Bills what
///            DataForSEO actually charged, which happens at task_post: a
///            standard-queue task that is posted and later fails was still
///            paid for, so it must stay in this sum.
///   QUOTA  — COUNT(*) WHERE resultAt IS NOT NULL, over the same window. The
///            user-facing "searches used" number, which may only count calls
///            that produced something the tenant can look at.
///
/// `ok` therefore means "DataForSEO accepted and billed the call", NOT "the
/// tenant got an answer". For live endpoints the two coincide and resultAt is
/// stamped at insert. For the standard queue they are minutes apart, and a task
/// can be billed at post and still never return a result.
model SeoApiCall {
  id               String    @id @default(cuid())
  tenantId         String
  feature          String // domain_overview | keyword_research | backlinks | rank_tracking | site_audit | local_seo | content_research
  path             String // "v3/dataforseo_labs/google/ranked_keywords/live"
  costUsd          Decimal   @db.Decimal(10, 6)
  /// Billed by DataForSEO. Drives the USD cap; never the search quota.
  ok               Boolean
  /// Set when a usable result exists — at insert for live calls, by the
  /// standard-queue poller for task_post calls. NULL means posted-but-unresolved
  /// or failed, and is excluded from the search quota by design.
  resultAt         DateTime?
  /// DataForSEO's task uuid, for standard-queue calls only. The poller has the
  /// task id and nothing else, so this is how it finds the row to stamp.
  dataforseoTaskId String?
  createdAt        DateTime  @default(now())

  @@index([tenantId, createdAt])
  /// The quota aggregate: one tenant, one month, successful rows only.
  @@index([tenantId, resultAt])
  /// Poller lookup by task id.
  @@index([dataforseoTaskId])
}

model SeoDomainSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  target       String
  locationCode Int
  languageCode String
  payload      Json
  fetchedAt    DateTime @default(now())

  @@unique([tenantId, target, locationCode, languageCode])
}

model SeoKeywordOverviewCache {
  id           String   @id @default(cuid())
  tenantId     String
  keyword      String
  locationCode Int
  languageCode String
  payload      Json
  fetchedAt    DateTime @default(now()) // 7 d TTL, enforced in code

  @@unique([tenantId, keyword, locationCode, languageCode])
}

/// SERP Checker — one row per submitted DataForSEO standard-queue task.
/// The POST route writes it as `queued`; the serp-checks worker polls
/// tasks_ready and fills `results` + `serpFeatures`, or `error`.
///
/// The search params are columns rather than a JSON blob because the 24 h
/// cache lookup queries on all four of them together (see the composite index).
model SerpCheck {
  id               String    @id @default(cuid())
  tenantId         String
  keyword          String
  locationCode     Int
  languageCode     String
  device           String // desktop | mobile
  dataforseoTaskId String?   @unique
  status           String    @default("queued") // queued | completed | failed
  costUsd          Decimal   @default(0) @db.Decimal(10, 6)
  results          Json? // { items: SerpResultItem[] } — top 100 organic
  serpFeatures     Json? // string[] of non-organic element types present
  itemCount        Int?
  error            String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  // Cache lookup: newest completed check for this exact query.
  @@index([tenantId, keyword, locationCode, languageCode, device, status, createdAt])
  // History list.
  @@index([tenantId, createdAt])
  // Worker sweep: queued rows, oldest first.
  @@index([status, createdAt])
}

/// Site Explorer — one row per domain analysis. An analysis is FOUR live
/// DataForSEO calls (domain_rank_overview, ranked_keywords, competitors_domain,
/// backlinks/summary) run in sequence inside a single POST; each is sub-second,
/// so there is no worker and no `queued` state.
///
/// Sections are stored independently and `failedSections` names the ones that
/// did not come back: a partial analysis is worth keeping (and worth showing)
/// rather than discarding three good sections because one endpoint 500'd.
///
/// locationCode/languageCode are columns, not a params blob, because the 24 h
/// per-(tenant, domain) cache lookup queries on them (see the composite index).
model SiteExplorerAnalysis {
  id             String   @id @default(cuid())
  tenantId       String
  domain         String // normalized: no scheme, no www., no path, lowercase
  locationCode   Int
  languageCode   String
  status         String   @default("completed") // completed | partial
  costUsd        Decimal  @default(0) @db.Decimal(10, 6)
  overview       Json? // OverviewSection — traffic, keyword count, rank spread
  rankedKeywords Json? // RankedKeywordsSection — top 100 rows
  competitors    Json? // CompetitorsSection — top 20 rows
  backlinks      Json? // BacklinksSection — link profile headline metrics
  failedSections Json? // string[] of section keys that did not load
  createdAt      DateTime @default(now())

  // Cache lookup: newest analysis for this exact target.
  @@index([tenantId, domain, locationCode, languageCode, createdAt])
  // History list.
  @@index([tenantId, createdAt])
}

/// AI Lens — one measurement of what an AI answer engine sees on one URL.
/// The sidecar fetches the page twice (raw HTTP as GPTBot, then rendered in
/// chromium) and diffs the two markdown renderings; this row is the result.
///
/// url is stored as submitted-then-normalized (scheme + host + path, no
/// fragment), NOT reduced to a domain: the whole point is per-page, and two
/// pages on one site routinely have very different gaps.
model AiLensAnalysis {
  id                String   @id @default(cuid())
  tenantId          String
  url               String
  /// Percent of RENDERED words absent from the raw fetch. 0 = fully readable.
  /// One decimal, so Decimal not Int — 0.4% and 0% are different answers.
  gapPercent        Decimal  @db.Decimal(5, 1)
  rawWordCount      Int
  renderedWordCount Int
  /// [{text_excerpt, approx_location, word_count}] — capped by the sidecar.
  missingBlocks     Json
  /// Status codes, fetch timings, redirects, robots/noindex flags, the UA used.
  meta              Json
  createdAt         DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Cache lookup: newest analysis for this exact URL.
  @@index([tenantId, url, createdAt])
  // History list.
  @@index([tenantId, createdAt])
  @@map("ai_lens_analyses")
}

/// Bot Analytics — one active access check for one domain.
///
/// Two signals per bot, and the pair is the point: `robotsRule` is what the site
/// SAYS, `httpStatus` is what the edge actually DID when we asked as that bot.
/// A site can publish "Allow: /" and still have its WAF return 403 to GPTBot;
/// robots.txt-only reporting calls that site open to ChatGPT when it is not.
///
/// `results` is per-bot rather than columns because the bot list is config
/// (src/lib/bot-catalog.ts) and grows — Meta added meta-externalagent after this
/// tool shipped. A column per crawler would mean a migration per crawler.
model BotAccessCheck {
  id            String   @id @default(cuid())
  tenantId      String
  /// Hostname checked, normalized. Stored per row so history stays readable
  /// after the tenant points the tool at a different site.
  domain        String
  /// { "<token>": { robotsRule, httpStatus, verdict, detail, probed } }
  /// verdict: allowed | blocked_robots | blocked_http | challenged | unknown
  results       Json
  robotsPresent Boolean  @default(false)
  sitemapFound  Boolean  @default(false)
  llmsTxt       Boolean  @default(false)
  /// Set when the sidecar could not complete the check at all; `results` is
  /// then the robots-only partial rather than a silent green.
  error         String?
  checkedAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, checkedAt])
  @@map("bot_access_checks")
}

enum BotLogStatus {
  PENDING
  PROCESSING
  COMPLETE
  FAILED
}

/// Bot Analytics — aggregates from one uploaded access log.
///
/// AGGREGATES ONLY, BY DESIGN. Access logs carry visitor IP addresses, which are
/// personal data we have no reason to hold: the worker parses the upload, writes
/// the counts below, and deletes the file. There is deliberately no column that
/// could hold a raw line or an IP, so a future "just keep a sample for
/// debugging" change has to add one and argue for it.
///
/// This is the ground-truth half of the tool. The access check says whether a
/// crawler COULD reach the site; only the logs say whether it DID.
model BotLogAnalysis {
  id           String       @id @default(cuid())
  tenantId     String
  /// Original upload name, for the history list. Never a path on disk.
  filename     String
  sizeBytes    Int
  status       BotLogStatus @default(PENDING)
  /// Human-readable reason when status is FAILED (unparseable, empty, too big).
  error        String?
  /// Detected from the log's own timestamps, not from the upload time.
  periodStart  DateTime?
  periodEnd    DateTime?
  linesParsed  Int          @default(0)
  linesSkipped Int          @default(0)
  botHits      Int          @default(0)
  /// { perBotPerDay, topPaths, statusSplit, firstLastSeen, verified } — counts
  /// and paths only. See src/lib/bot-analytics/log-parser.ts for the shape.
  aggregates   Json?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("bot_log_analyses")
}

/// Rank Tracker — a tracking project: one domain, a set of keywords, one
/// market, checked on a schedule. Keywords are checked through the SAME
/// DataForSEO standard queue as the SERP Checker ($0.0006/keyword); the shared
/// sweep in serp-check.worker.ts routes finished task ids to RankSnapshot.
///
/// `active=false` is a soft pause: the project and its history stay, but the
/// scheduler skips it. `overCap` is set BY THE SCHEDULER when a downgrade
/// leaves a project holding more keywords than its plan now allows — the run
/// is skipped rather than silently truncated, and the UI explains why.
model RankProject {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  domain       String // normalized: no scheme, no www., no path
  locationCode Int
  languageCode String
  device       String // desktop | mobile
  frequency    String // daily | weekly
  active       Boolean   @default(true)
  /// Scheduler-set: plan cap exceeded (e.g. after a downgrade). Blocks runs.
  overCap      Boolean   @default(false)
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  keywords RankKeyword[]

  // Project list, newest first.
  @@index([tenantId, createdAt])
  // Scheduler sweep: active projects, cheapest possible scan.
  @@index([active, frequency])
}

/// One tracked keyword inside a project. Unique per project so re-submitting
/// the same textarea cannot create duplicates that would each cost $0.0006.
model RankKeyword {
  id        String   @id @default(cuid())
  projectId String
  keyword   String
  createdAt DateTime @default(now())

  project   RankProject    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  snapshots RankSnapshot[]

  @@unique([projectId, keyword])
  @@index([projectId])
}

/// One keyword, one run. `position` is null when the domain did not appear in
/// the top 100 — a real, meaningful result, NOT missing data, which is why the
/// column is nullable rather than defaulting to 0 or 101.
///
/// `status` mirrors SerpCheck's queue-status pattern: rows are written `queued`
/// at task_post time and completed by the shared sweep.
model RankSnapshot {
  id               String    @id @default(cuid())
  keywordId        String
  runDate          DateTime  @default(now())
  status           String    @default("queued") // queued | completed | failed
  position         Int? // null = not in the top 100
  url              String? // best-ranking URL for the tracked domain
  serpFeatures     Json? // string[] of non-organic element types present
  dataforseoTaskId String?   @unique
  costUsd          Decimal   @default(0) @db.Decimal(10, 6)
  error            String?
  completedAt      DateTime?

  keyword RankKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  // History chart + latest-position lookup for one keyword.
  @@index([keywordId, runDate])
  // Shared sweep: queued rows with a task id, oldest first.
  @@index([status, runDate])
}

/// Backlinks tool — one row per analysis. An analysis is FIVE live DataForSEO
/// Backlinks calls (summary, history, referring_domains, anchors, domain_pages)
/// run in sequence inside a single POST; the family has no standard queue, so
/// there is no worker and no `queued` state.
///
/// Sections are stored independently and `failedSections` names the ones that
/// did not come back: a partial analysis is worth keeping (and worth showing)
/// rather than discarding four good sections because one endpoint 500'd.
///
/// `mode` is part of the cache key, not decoration: "example.com" in domain
/// mode and "https://example.com/pricing" in exact-URL mode are different
/// questions with different answers and must never share a cached row.
model BacklinksAnalysis {
  id               String   @id @default(cuid())
  tenantId         String
  target           String // normalized: bare host (domain) or absolute URL (exact_url)
  mode             String // domain | exact_url
  status           String   @default("completed") // completed | partial
  costUsd          Decimal  @default(0) @db.Decimal(10, 6)
  summary          Json? // SummarySection — totals, rank, dofollow split
  history          Json? // HistorySection — monthly growth series
  referringDomains Json? // ReferringDomainsSection — top 50
  anchors          Json? // AnchorsSection — top 30 anchor texts
  pages            Json? // PagesSection — top 20 most-linked pages
  failedSections   Json? // string[] of section keys that did not load
  createdAt        DateTime @default(now())

  // Cache lookup: newest analysis for this exact target + mode.
  @@index([tenantId, target, mode, createdAt])
  // History list.
  @@index([tenantId, createdAt])
}

/// Content Explorer — one search for a phrase across DataForSEO's Content
/// Analysis index. A "search" is one or two live calls: search/live always, and
/// summary/live only when the first reports a non-zero total.
///
/// COST IS ~96% FIXED, which shapes this table. Measured Jul 2026: each call
/// bills $0.024036 regardless of how much it returns, plus roughly $0.0000353
/// per returned item — so a search that finds NOTHING costs $0.024 and a search
/// returning 50 rows costs $0.0258. That is why the row is persisted even when
/// it found zero mentions (re-running would cost the same again, so the empty
/// answer is worth caching) and why `summary` is nullable rather than assumed.
///
/// `costUsd` is the sum of the envelope `cost` fields for this search, never a
/// price-table estimate — see the note at the top of dataforseo/metering.ts.
model ContentSearch {
  id        String   @id @default(cuid())
  tenantId  String
  /// The phrase as searched: trimmed and lowercased, so the cache key and the
  /// history list do not treat "Echorank360" and "echorank360" as two searches.
  query     String
  /// The angle preset the query came from (brand | competitor | topic). Purely
  /// a UI label — every preset runs the identical code path.
  angle     String   @default("topic")
  /// { limit, offset, search_mode } as sent, so a stored row can be explained.
  params    Json
  /// content_analysis/search/live: total_count + the page items we kept.
  results   Json
  /// content_analysis/summary/live: totals, sentiment split, top domains,
  /// countries, languages. Null when the search found nothing — the summary
  /// endpoint returns all-zero fields for a zero-result phrase, so calling it
  /// would spend $0.024 to learn nothing.
  summary   Json?
  costUsd   Decimal  @default(0) @db.Decimal(10, 6)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Cache lookup: newest search for this exact phrase.
  @@index([tenantId, query, createdAt])
  // History list.
  @@index([tenantId, createdAt])
  @@map("content_searches")
}

/// Lighthouse tool — one row per audit. An audit is ONE PageSpeed Insights
/// call (Google's own Lighthouse runner), not DataForSEO, and it is free.
///
/// Mobile and desktop are separate audits, not two halves of one: Lighthouse
/// throttles them differently and they routinely differ by 30+ points, so
/// `strategy` is part of both the row identity and the 6 h cache key.
///
/// `crux` is nullable because most pages have no field data: CrUX only reports
/// URLs with enough real Chrome traffic. Null means "Google has no field data",
/// which the UI must say out loud rather than render as zeros.
model LighthouseAudit {
  id                String   @id @default(cuid())
  tenantId          String
  url               String // normalized absolute URL, fragment stripped
  strategy          String // mobile | desktop
  scores            Json // CategoryScores — performance/a11y/best-practices/seo
  metrics           Json // LabMetric[] — FCP, LCP, TBT, CLS, SI, TTI
  opportunities     Json // Opportunity[] — sorted by estimated saving
  crux              Json? // CruxData — null when the page has no field data
  /// Lighthouse version, so an odd score can be traced to a scoring change.
  lighthouseVersion String?
  fetchedAt         DateTime @default(now())

  // Cache lookup: newest audit for this exact URL + strategy.
  @@index([tenantId, url, strategy, fetchedAt])
  // History list.
  @@index([tenantId, fetchedAt])
}

/// Site Audit — one row per technical-SEO crawl of a domain.
///
/// DISTINCT FROM the audit on /visibility: that one measures AI-engine
/// readability (the AI Visibility product). This one is DataForSEO's OnPage
/// crawler checking classic technical SEO — broken links, duplicate titles,
/// 4xx/5xx, canonical and https problems. Both exist on purpose; the copy on
/// each page says so.
///
/// An ASYNC CRAWL, not a standard-queue task: OnPage is posted once and then
/// polled via on_page/summary/<taskId> until crawl_progress is "finished",
/// which can take minutes. `status` therefore has a real `crawling` state that
/// the UI polls, and the row is safe to leave and come back to.
///
/// Billed per page CRAWLED, so `maxPages` is the cost lever and is clamped to
/// the tenant's plan at start time.
model SiteAudit {
  id               String    @id @default(cuid())
  tenantId         String
  domain           String // normalized: no scheme, no www., no path
  maxPages         Int
  dataforseoTaskId String?   @unique
  status           String    @default("queued") // queued | crawling | completed | failed
  /// Pages crawled so far — drives the progress bar during the crawl.
  pagesCrawled     Int       @default(0)
  summary          Json? // SummarySection — onpage_score, page/request totals
  issues           Json? // IssuesSection — problem checks grouped by severity
  pages            Json? // PagesSection — worst pages, up to 100 rows
  costUsd          Decimal   @default(0) @db.Decimal(10, 6)
  error            String?
  createdAt        DateTime  @default(now())
  finishedAt       DateTime?

  // Cache lookup: newest audit for this domain.
  @@index([tenantId, domain, createdAt])
  // History list.
  @@index([tenantId, createdAt])
  // Poller sweep: unfinished rows with a task id, oldest first.
  @@index([status, createdAt])
}

enum GaConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
}

/// Web Analytics — one GA4 connection per tenant.
///
/// A SEPARATE token set from GscConnection rather than incremental scope on
/// it. The two integrations are independently connectable and disconnectable,
/// and widening the GSC token to carry analytics.readonly would mean
/// disconnecting Search Console also killed Analytics. Same shape, same
/// crypto (lib/gsc/crypto.ts), same 401 -> retry -> NEEDS_REAUTH contract.
///
/// No report data is stored: GA4 already holds the history, so reports are
/// queried live and cached in Redis for an hour. This row is the whole
/// persistence footprint of the feature.
model GaConnection {
  id              String             @id @default(cuid())
  tenantId        String             @unique
  /// v1:<iv>:<tag>:<ciphertext> (base64url segments), same format as GSC.
  refreshTokenEnc String
  /// Chosen GA4 property, "properties/123456789"; null until picked.
  propertyId      String?
  /// Human label for the picked property, so the UI need not re-query.
  propertyName    String?
  status          GaConnectionStatus @default(ACTIVE)
  connectedAt     DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("ga_connections")
}

/// Page HTML snapshots over time — the storage half of the Historical tool.
///
/// METADATA ONLY. The gzipped markdown body lives in DigitalOcean Spaces at
/// `snapshots/<tenantId>/<sha256>.md.gz`, private ACL, streamed back through an
/// authenticated route. AiLensAnalysis deliberately does not persist its
/// markdown ("hundreds of KB per row... would make the table the largest in the
/// database within a month") — that reasoning is why the body is in object
/// storage rather than a bytea column here.
///
/// Dedupe is by contentHash: an unchanged page re-captured writes no new row and
/// uploads no new object.
model PageSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  url         String
  /// The moment the CONTENT is from, not the moment we stored it. For a Wayback
  /// import this is the archive's own timestamp, which is the whole point of
  /// backfilling — a row stamped `now()` would put 2019 content on today.
  capturedAt  DateTime
  /// sha256 of the markdown, hex. Dedupe key and the object name.
  contentHash String
  /// Spaces object key. Several rows may share one object (same content at
  /// different URLs or times), so objects are deleted only when the last
  /// referencing row goes.
  objectKey   String
  sizeBytes   Int
  /// ai_lens | manual | wayback
  source      String
  createdAt   DateTime @default(now())

  @@index([tenantId, url, capturedAt])
  /// Dedupe lookup, and the reference count that guards object deletion.
  @@index([tenantId, contentHash])
  @@map("page_snapshots")
}

/// A Synapse (Matrix) account provisioned for one app user on one tenant.
///
/// The PASSWORD IS NOT HERE and must never be. It is generated per provision,
/// returned in that one HTTP response, and forgotten — Synapse holds the hash,
/// we hold only the identifier. A password column would turn a database read
/// into account takeover for every chat account we have ever issued.
///
/// Rows are kept after deactivation rather than deleted: `deactivatedAt` is
/// what makes a downgrade auditable, and what stops a re-upgrade silently
/// reusing an mxid whose history belongs to a deactivated account.
model MatrixAccount {
  id            String    @id @default(cuid())
  tenantId      String
  /// The Echorank user this account belongs to.
  appUserId     String
  /// Full Matrix ID, e.g. @acme.jane:echorank360.com
  mxid          String    @unique
  createdAt     DateTime  @default(now())
  /// Null while the account is live. Set when a downgrade deactivates it.
  deactivatedAt DateTime?

  /// One account per user per tenant. The same person on two tenants gets two.
  @@unique([tenantId, appUserId])
  @@index([tenantId, deactivatedAt])
  @@map("matrix_accounts")
}

// ─── Site Crawler ────────────────────────────────────────────────────────────

enum CrawlStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/// One full-site crawl. Raw-HTML only — no JavaScript rendering, no external
/// API: the worker fetches and parses in-process.
///
/// `urlCap` is COPIED FROM THE PLAN AT CREATION rather than read at display
/// time, so a crawl that ran under one tier keeps reporting the ceiling it
/// actually ran under after an upgrade or downgrade.
///
/// `stoppedReason` distinguishes the ways a COMPLETED crawl can end early —
/// "url_cap", "time_cap" — from a clean exhaustion of the frontier, which
/// leaves it null. A FAILED crawl carries a truncated error here instead.
model CrawlJob {
  id            String      @id @default(cuid())
  tenantId      String
  rootUrl       String
  status        CrawlStatus @default(QUEUED)
  urlCap        Int
  pagesCrawled  Int         @default(0)
  issueCount    Int         @default(0)
  stoppedReason String?
  /// Site-wide aggregation output: distributions, duplicate/redirect counts,
  /// sitemap and inlink stats. COUNTS AND CAPPED SAMPLES ONLY — never full
  /// lists, so the column stays well under 100 KB on a 25,000-URL crawl.
  /// Written once, at the end of the crawl, before the status goes COMPLETED.
  summary       Json?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime    @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pages  CrawlPage[]

  @@index([tenantId, createdAt])
  @@map("crawl_jobs")
}

/// One crawled URL. The HTML BODY IS NEVER STORED — fields are extracted and
/// the body is discarded. `contentHash` is a SHA-256 of the normalized main
/// content, which is what makes duplicate detection possible without keeping
/// the text that would let anyone reconstruct the page.
model CrawlPage {
  id              String   @id @default(cuid())
  crawlJobId      String
  url             String
  statusCode      Int?
  /// Target of the FIRST redirect hop only; the chain length drives
  /// REDIRECT_CHAIN rather than being stored hop by hop.
  redirectTarget  String?
  title           String?
  titleLength     Int?
  metaDescription String?
  metaDescLength  Int?
  h1Count         Int?
  canonical       String?
  metaRobots      String?
  wordCount       Int?
  contentHash     String?
  depth           Int
  internalLinks   Int?
  fetchMs         Int?
  contentType     String?
  /// Internal links pointing AT this page, counted per source page (a page
  /// linking five times to the same URL counts once). Filled at aggregation
  /// from a Redis hash — there is deliberately no link-edge table, because an
  /// edge row per link would dwarf the page rows on any real site.
  inlinkCount     Int?
  /// Whether this URL appeared in the site's sitemap. Null when the crawl
  /// found no sitemap at all, which is different from "absent from it".
  inSitemap       Boolean?

  crawlJob CrawlJob     @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  issues   CrawlIssue[]

  @@index([crawlJobId])
  /// Duplicate detection reads this at write time: same hash, same crawl.
  @@index([crawlJobId, contentHash])
  @@map("crawl_pages")
}

/// One finding on one page. `type` and `severity` are enum-like strings rather
/// than Prisma enums so a new check ships without a migration — the closed set
/// lives in src/lib/site-crawler/checks.ts and is asserted in its tests.
model CrawlIssue {
  id          String  @id @default(cuid())
  crawlPageId String
  type        String
  severity    String
  detail      String?

  crawlPage CrawlPage @relation(fields: [crawlPageId], references: [id], onDelete: Cascade)

  @@index([crawlPageId])
  @@map("crawl_issues")
}

// ─── Free tools: SERP volatility ─────────────────────────────────────────────

/// One day's top-10 for one basket keyword.
///
/// The basket is fixed (30 keywords × 5 categories × 1 location) and sampled by
/// a daily worker, NOT by visitors: the public endpoint only reads. That is why
/// there is no tenant column — this data belongs to nobody and is the same for
/// every reader.
///
/// The volatility SCORE is not stored. It is a pure function of two consecutive
/// days' rows (see src/lib/free-tools/volatility.ts) and is computed on read
/// behind a 1h cache — storing it would mean a second thing to backfill when
/// the formula changes, and the formula is the part most likely to change.
model SerpVolatilitySample {
  id           String   @id @default(cuid())
  /// UTC day this sample represents.
  sampledOn    DateTime @db.Date
  /// ecommerce | local | finance | health | tech
  category     String
  keyword      String
  locationCode Int
  /// Ordered array of the top-10 domains. Domains, not URLs: a site changing
  /// its own URL structure is not SERP volatility.
  topDomains   Json
  createdAt    DateTime @default(now())

  /// One sample per keyword per day — makes the worker's upsert idempotent, so
  /// a retried tick cannot double-count a day.
  @@unique([sampledOn, keyword, locationCode])
  @@index([category, sampledOn])
  @@map("serp_volatility_samples")
}

// ─── AI Visibility Monitor ───────────────────────────────────────────────────
//
// Multi-provider brand checkups. Extends the existing AI-visibility stack
// rather than paralleling it: TrackedPrompt keeps being the prompt of record
// and PromptRun keeps being one provider's answer — both gain columns here
// instead of getting a twin table.

enum CheckupStatus {
  /// Created, not yet picked up by a runner.
  PENDING
  RUNNING
  /// Every planned run produced an answer. The metrics row is complete.
  READY
  /// Ran to the end with gaps: some runs were skipped at the spend cap or
  /// failed upstream. The metrics row EXISTS and is flagged partialCoverage —
  /// a score computed from two thirds of the plan is still the best available
  /// answer, and withholding it would show the customer nothing at all.
  PARTIAL
  /// Zero successful runs. Nothing worth scoring, so no metrics row.
  FAILED
}

/// How one planned run ended.
///
/// A RUN ROW EXISTS EVEN WHEN NOTHING WAS ASKED. The runner writes a row for
/// every slot in the plan, including the ones it refused to spend on, because
/// "we did not ask" and "we asked and you were absent" are different facts and
/// only the first must be kept out of the mention rate. A plan slot with no row
/// at all would be indistinguishable from a run that was never planned.
enum RunStatus {
  /// Answered. The only status that contributes to a score.
  OK
  /// Refused before the provider call: the tenant was at its monthly USD cap.
  /// Nothing went wrong and nothing was spent.
  SKIPPED_CAP
  /// The provider was asked and did not answer.
  FAILED
}

/// Where a tracked prompt came from. Drives the wizard's badges and lets
/// "regenerate ideas" exclude what a brand has already seen.
enum PromptSource {
  SUGGESTED
  CUSTOM
  EDITED
}

/// The brand a checkup is about.
///
/// NOT folded onto Tenant. Tenant already carries 67 columns, and its existing
/// `brand*` fields are visual identity and Marketing Studio voice — a different
/// concern. A separate entity also matches the spec's (brand_id, completed_at)
/// index: an agency tenant can hold more than one brand without reshaping
/// anything.
model BrandProfile {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  /// Public site, used by the setup wizard's context inference.
  website  String?
  industry String?

  /// What the business does, in a paragraph. Written by the onboarding pass
  /// from the site crawl, then editable. Feeds every prompt-generation and
  /// analysis system prompt, so it is the single highest-leverage field on the
  /// row: a vague description produces prompts nobody would ask.
  description        String?   @db.Text
  /// ISO-3166-1 alpha-2 primary market. `markets` carries the rest; this is
  /// the one used when a provider call needs a single location.
  country            String?
  /// BCP-47. Prompts are generated and asked in this language by default.
  language           String    @default("en")
  /// Set when the onboarding crawl + inference completed. Null means the
  /// project exists but was never enriched — the wizard resumes from there.
  onboardedAt        DateTime?
  /// { pages: [{url, title, chars}], robotsBlocked: bool, detectedIndustry,
  /// competitorEvidence: [...] } — what the crawl actually read. Kept so the
  /// UI can answer "why did you say we sell X?" rather than asking the user to
  /// trust an LLM summary with no provenance.
  onboardingEvidence Json?

  /// Other spellings that count as a mention: "Echorank360", "Echo rank".
  aliases     String[] @default([])
  competitors String[] @default([])
  /// Country/market names the prompts are localised for.
  markets     String[] @default([])
  audiences   String[] @default([])
  topics      String[] @default([])

  /// False until the setup wizard finishes. /visibility routes brands without
  /// an active config to the wizard, so this is the flag it reads.
  trackingActive Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prompts  TrackedPrompt[]
  checkups Checkup[]
  trends   CheckupTrend[]

  visibilityMetrics VisibilityMetric[]
  sources           Source[]
  recommendations   Recommendation[]
  experiments       Experiment[]
  /// AI Share of Voice. The brand profile IS the prompt set — see SovSnapshot.
  sovSnapshots      SovSnapshot[]

  @@index([tenantId])
  @@map("brand_profiles")
}

/// One scheduled (or manual) run across providers and prompts.
///
/// The tier's shape is COPIED ONTO THE ROW at creation — providers, prompts and
/// reps — so a checkup keeps reporting the shape it actually ran under after an
/// upgrade, downgrade or config edit. Same reasoning as CrawlJob.urlCap.
model Checkup {
  id             String        @id @default(cuid())
  tenantId       String
  brandProfileId String
  status         CheckupStatus @default(PENDING)
  /// True for "Run checkup now". Counts against the same monthly cap.
  manual         Boolean       @default(false)

  /// Shape this checkup ran under, snapshotted from plan-config at creation.
  providers   String[] @default([])
  promptCount Int      @default(0)
  repetitions Int      @default(1)

  /// Rolled up when the checkup completes; null while it runs.
  visibilityScore    Float?
  repeatabilityScore Float?
  /// Total USD across every provider + analysis call in this checkup.
  costUsd            Decimal @default(0) @db.Decimal(10, 6)

  /// "cap_reached" | a truncated error. Null on a clean finish.
  stoppedReason String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandProfile BrandProfile     @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  runs         PromptRun[]
  calls        AiProviderCall[]

  /// Dashboard reads: this brand's checkups, newest first.
  @@index([brandProfileId, completedAt])
  @@index([tenantId, createdAt])
  @@map("checkups")
}

/// What one provider said about one prompt, analysed.
///
/// Split from PromptRun rather than widened into it: PromptRun is the raw
/// answer (kept even when analysis fails), and this is the interpretation. One
/// row per run, so a re-analysis replaces rather than accumulates.
model MentionAnalysis {
  id          String @id @default(cuid())
  promptRunId String @unique

  // ── Deterministic pass (no LLM, always present) ──
  brandMentioned  Boolean
  mentionCount    Int      @default(0)
  /// 1-based position in the answer's first list, if the brand appears in one.
  listPosition    Int?
  competitorNames String[] @default([])
  /// Registrable domains cited in the answer that match the brand's site.
  citedOwnDomain  Boolean  @default(false)
  citedDomains    String[] @default([])
  /// Text around each mention, for the dashboard's context panel.
  contextSnippets String[] @default([])

  // ── LLM pass (Haiku, only when brandMentioned) ──
  recommended            Boolean?
  /// 0-1. Multiplies the recommendation weight in the score.
  recommendationStrength Float?
  /// positive | neutral | negative
  sentiment              String?
  quotedDescription      String?  @db.Text
  factualClaims          String[] @default([])
  possibleInaccuracies   String[] @default([])
  /// 0-1. The whole weighted score is multiplied by this.
  confidence             Float?

  /// Weighted visibility score for this single response, 0-100.
  visibilityScore Float    @default(0)
  createdAt       DateTime @default(now())

  /// Character offset of the first mention in the normalized answer. A brand
  /// named in the opening sentence and one named in a closing footnote are not
  /// equally visible, and listPosition cannot tell them apart — it is null for
  /// both when the answer has no list.
  firstPosition          Int?
  /// 1-based place in the answer's recommendation list, when the answer makes
  /// one. Distinct from listPosition: an answer can enumerate six vendors and
  /// then recommend the third, and the prominence score pays for the second.
  recommendationPosition Int?
  /// 0-100, the spec's additive prominence ladder (appears / recommended /
  /// cited / described positively). NOT the same number as visibilityScore,
  /// which is the weighted multiplicative score in scoring.ts. Both are kept:
  /// the ladder is legible to a customer ("+40 because you were the first
  /// recommendation"), the weighted score is what the trend line uses.
  prominenceScore        Int   @default(0)
  /// { strengths[], weaknesses[], pricePosition, quality, trust, innovation,
  /// targetCustomer, categoryAssociations[] } — what the model believes about
  /// the brand. JSON rather than columns: this is evidence for the
  /// recommendation engine, never a filter or a sort key.
  attributes             Json?

  /// Set when the strict-JSON pass failed twice. The run is parked for review
  /// rather than retried forever or dropped — a queue that crashes on one bad
  /// response takes the whole checkup with it, and a response silently
  /// discarded is a visibility score quietly computed from less data than it
  /// claims.
  quarantinedAt    DateTime?
  quarantineReason String?

  promptRun PromptRun @relation(fields: [promptRunId], references: [id], onDelete: Cascade)

  /// Review queue read: what failed to parse, oldest first.
  @@index([quarantinedAt])
  @@map("mention_analyses")
}

/// One day's rolled-up scores per brand, for the trend chart.
model CheckupTrend {
  id             String   @id @default(cuid())
  brandProfileId String
  /// UTC day.
  day            DateTime @db.Date

  visibilityScore    Float
  repeatabilityScore Float?
  mentionRate        Float?
  /// { provider: score } — small, so JSON rather than a row per provider.
  byProvider         Json?
  createdAt          DateTime @default(now())

  brandProfile BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  /// One row per brand per day; the writer upserts, so a re-run cannot double.
  @@unique([brandProfileId, day])
  @@index([brandProfileId, day])
  @@map("checkup_trends")
}

/// Every LLM call the monitor makes, metered.
///
/// The SeoApiCall pattern, for AI spend: one row per provider call and per
/// analysis call, with the token counts the price was computed from. Costs are
/// DERIVED from tokens at write time and stored — a price table that changed
/// later must not silently restate what a tenant was already charged.
model AiProviderCall {
  id        String  @id @default(cuid())
  tenantId  String
  /// Null for calls outside a checkup (the wizard's brand-context inference).
  checkupId String?

  /// CLAUDE | CHATGPT | GOOGLE_AI_OVERVIEWS | GEMINI | GROK | MISTRAL | LLAMA
  provider String
  model    String
  /// analysis | answer | inference — what the call was for.
  purpose  String @default("answer")

  inputTokens       Int     @default(0)
  outputTokens      Int     @default(0)
  /// Cache reads are billed at a fraction of input; kept so the cost is
  /// reproducible from the row alone.
  cachedInputTokens Int     @default(0)
  costUsd           Decimal @db.Decimal(10, 6)
  ok                Boolean @default(true)
  error             String?

  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checkup Checkup? @relation(fields: [checkupId], references: [id], onDelete: SetNull)

  /// The monthly cap aggregate: one tenant, one month.
  @@index([tenantId, createdAt])
  @@index([checkupId, provider])
  @@map("ai_provider_calls")
}

/// Consent captured at checkout, per §8.2 of the Subscription Agreement.
///
/// Every field the agreement names is stored: version, document ids, timestamp,
/// and the plan the consent was given for. Kept as its own append-only table
/// rather than columns on Tenant — a tenant consents once per checkout, not
/// once ever, and a compliance answer needs the history, not the latest value.
model ConsentEvent {
  id String @id @default(cuid())

  /// All nullable: a guest consents BEFORE any user or tenant exists. The
  /// webhook backfills them when it provisions the account.
  tenantId String?
  userId   String?
  email    String?

  /// The Stripe Checkout Session this consent belongs to. UNIQUE — a replayed
  /// webhook must not write a second row for one act of consent.
  stripeSessionId String? @unique

  version     String
  /// The document ids as sent, so a later config change cannot rewrite what
  /// someone actually agreed to.
  documents   Json
  plan        String
  interval    String
  /// "upgrade" | "guest_signup"
  flow        String
  /// Client-supplied moment of the click. Recorded, never trusted for auth.
  consentedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, createdAt])
  @@index([email])
  @@map("consent_events")
}

// ─────────────────────────────────────────────────────────────
// AI SEARCH INTELLIGENCE — engines, citations, sources, actions
//
// Built ON the AI Visibility Monitor above rather than beside it: BrandProfile
// is the project, TrackedPrompt is the prompt, PromptRun is the run, Tenant is
// the organization. A parallel Project/Organization pair would have meant a
// second tenancy path, a second plan-limit check and a second cost ledger, and
// the first bug would have been a route that scoped to the wrong one.
// ─────────────────────────────────────────────────────────────

/// How often the scheduler asks a prompt.
///
/// An enum rather than an interval column because the scheduler sweeps by
/// bucket, and because "every 37 hours" is a support ticket waiting to happen.
enum PromptFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

/// What kind of page a citation points at.
///
/// Drives the recommendation engine more than the dashboard: a competitor
/// winning on COMPARISON pages needs a comparison page built, one winning on
/// FORUM threads needs a community presence, and those are different projects.
enum CitationType {
  EDITORIAL
  COMPARISON
  REVIEW
  DOCS
  FORUM
  SOCIAL
  OTHER
}

enum SourceType {
  PUBLISHER
  VENDOR
  MARKETPLACE
  COMMUNITY
  DOCS
  SOCIAL
  OTHER
}

/// What KIND of site a citing domain is, for Citation Finder.
///
/// A SECOND TAXONOMY ALONGSIDE SourceType, deliberately, and the two are not
/// merged. SourceType asks "what is this domain's relationship to the market"
/// (a vendor, a marketplace, a community); this asks "what kind of publication
/// is it" — the question a customer answers when deciding whether they can get
/// listed on it. G2 is a VENDOR-adjacent MARKETPLACE under one lens and a
/// REVIEW_SITE under the other, and both readings are useful. Collapsing them
/// would have forced one of the two questions to go unanswered.
///
/// Assigned by src/lib/citations/classify.ts, which is a pure function of the
/// domain — so re-classifying is a re-run over stored rows, never a re-run of
/// the provider calls. Same principle EntityClass documents.
enum CitationKind {
  /// Listing sites and business directories: Yelp, Yellow Pages, Crunchbase.
  DIRECTORY
  /// Software and product review platforms: G2, Capterra, Trustpilot.
  REVIEW_SITE
  /// Newspapers, wires, and trade press.
  NEWS
  /// Independent blogs, Medium-style platforms, and company blogs.
  BLOG
  /// Government and public-sector domains, including .gov and .gc.ca.
  GOV
  /// Social networks and forums: LinkedIn, Reddit, X, YouTube.
  SOCIAL
  /// Nothing above matched. The honest default, never a wastebasket for
  /// low-confidence guesses — an unknown domain is unknown.
  OTHER
}

enum RecommendationType {
  CONTENT_GAP
  CITATION_OPPORTUNITY
  WEAK_ASSOCIATION
  NEGATIVE_SENTIMENT
  STRUCTURED_DATA
  ENTITY_SIGNAL
  AUTHORITY_SIGNAL
  HIGH_VALUE_PROMPT
}

enum RecommendationStatus {
  OPEN
  IN_PROGRESS
  DONE
  DISMISSED
  /// Superseded by a newer generation of the same finding. Kept rather than
  /// deleted so a brand can see that an action it never took has gone stale.
  STALE
}

enum ExperimentStatus {
  RUNNING
  SUCCEEDED
  /// Ran to its horizon without a statistically meaningful improvement.
  INCONCLUSIVE
  ABANDONED
}

/// One (provider, model) the monitor can query.
///
/// A TABLE, not a constant, even though the catalogue in
/// src/lib/ai-monitor/engines.ts seeds it. Two things have to be true at once:
/// the code must know each engine's capabilities to build a request, and an
/// operator must be able to switch one off at 3am when a vendor breaks without
/// a rebuild on a box that serves production from its working tree. The
/// catalogue supplies the first, this row supplies the second.
///
/// GLOBAL, NOT TENANT-SCOPED. Availability is a property of our API keys, not
/// of a customer's plan; what a tier may use is `aiCheckup.providers` in
/// plan-config.ts.
model AIEngine {
  id String @id @default(cuid())

  /// Matches AI_PROVIDERS in src/lib/ai-monitor/pricing.ts.
  provider          String
  modelName         String
  /// Human label for the dashboard's per-engine table.
  displayName       String
  /// Whether the engine actually searches the live web. An engine answering
  /// from training data alone cannot be moved by publishing a page this week,
  /// so the recommendation engine must not promise that it can.
  supportsSearch    Boolean @default(false)
  /// Whether it returns citations. Without them, citationRate for this engine
  /// is not zero — it is unmeasurable, and the rollup records null, not 0.
  supportsCitations Boolean @default(false)
  /// Operator kill switch. An engine whose API key is missing is disabled at
  /// runtime regardless of this flag; this turns off one that works.
  enabled           Boolean @default(true)
  /// Display order in the per-engine table.
  sortOrder         Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, modelName])
  @@index([enabled, sortOrder])
  @@map("ai_engines")
}

/// One URL an answer cited.
///
/// Rows, not a JSON array on PromptRun, because this table is the input to the
/// influence graph: "which domains cite my competitors and never me" is a
/// GROUP BY over millions of these, and a JSON column would make it a table
/// scan with a parse per row.
model Citation {
  id          String @id @default(cuid())
  tenantId    String
  promptRunId String

  url    String  @db.Text
  /// Registrable domain, via src/lib/registrable-domain.ts. The join key to
  /// Source, so it must be computed the same way in both places.
  domain String
  title  String?

  /// 1-based order of appearance in the answer. Earlier citations carry the
  /// claim the answer leads with.
  citationPosition   Int?
  /// Whether the sentence this citation supports is about the brand.
  supportsBrand      Boolean      @default(false)
  /// The competitor whose claim it supports, if any. A name rather than a FK:
  /// competitors are strings on BrandProfile, and a citation naming a company
  /// the brand never listed is still worth recording.
  supportsCompetitor String?
  citationType       CitationType @default(OTHER)

  // ── Verification pass (Phase 4) ──
  /// Null until VerifyCitationsTask has run. A model citing a URL that 404s,
  /// or that never mentions the brand it was cited for, is a hallucinated
  /// citation — which is a finding, not a data error.
  verifiedAt       DateTime?
  httpStatus       Int?
  /// Whether the page's <title> resembles the title the model claimed.
  titleMatches     Boolean?
  brandOnPage      Boolean?
  competitorOnPage Boolean?
  verifyError      String?

  /// Set by the Source aggregator. Null until a domain has been rolled up.
  sourceId String?

  createdAt DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promptRun PromptRun @relation(fields: [promptRunId], references: [id], onDelete: Cascade)
  source    Source?   @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  /// A model can cite the same URL twice in one answer; that is one citation.
  @@unique([promptRunId, url])
  @@index([tenantId, domain, createdAt])
  @@index([sourceId, createdAt])
  /// Verification sweep: what has not been checked yet.
  @@index([verifiedAt])
  @@map("citations")
}

/// What a named entity turned out to be, per analysis/competitor-filter.ts.
///
/// Stored beside the raw mention rather than used to filter at write time: a
/// classification is a LENS over an observation, so tuning the rules later is a
/// re-run of a pure function over rows we already hold, not a re-run of the
/// provider calls that produced them.
enum EntityClass {
  /// A product that competes with the brand. The only class the rollup counts.
  RIVAL
  /// An assistant, cloud or console the answer names because it IS one, or
  /// because it is telling the reader where to look.
  PLATFORM
  /// A bare category word, or the brand's own category vocabulary.
  GENERIC
}

/// A competitor's appearance in one answer.
///
/// Mirrors MentionAnalysis for the brand, one row per competitor per run. Share
/// of voice is a sum over these against the brand's own prominence, so they
/// have to be measured on the same scale — hence prominenceScore here too.
model CompetitorMention {
  id          String @id @default(cuid())
  tenantId    String
  promptRunId String

  name                   String
  mentionCount           Int     @default(0)
  firstPosition          Int?
  recommendationPosition Int?
  prominenceScore        Int     @default(0)
  /// positive | neutral | negative
  sentiment              String?
  context                String? @db.Text

  /// Null for a row written before the classifier existed. NOT defaulted to
  /// RIVAL: claiming an unexamined entity is a competitor is the error this
  /// whole module exists to stop, and null is honestly "not yet judged".
  classification      EntityClass?
  /// Which rule set produced `classification`. 0 means never classified.
  /// Same contract as VisibilityMetric.scoreVersion: rows keep the verdict
  /// they were given, and re-judging is an explicit new version rather than a
  /// silent restatement.
  classifierVersion   Int          @default(0)
  /// The signals that fired, with their weights and a sentence each. Rendered
  /// in the UI so a customer can see WHY something was called a platform,
  /// which is what makes a deterministic rule table defensible where an
  /// unexplainable model call would not be.
  classificationTrace Json?

  createdAt DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promptRun PromptRun @relation(fields: [promptRunId], references: [id], onDelete: Cascade)

  @@unique([promptRunId, name])
  /// Rollup read: this tenant's rivals, excluding platforms and categories.
  @@index([tenantId, classification, createdAt])
  @@index([tenantId, name, createdAt])
  @@map("competitor_mentions")
}

/// One day's rolled-up numbers for one project on one engine.
///
/// SEPARATE FROM CheckupTrend, which is one row per brand per day with a
/// `byProvider` JSON blob. That shape answers "how are we doing?" and cannot
/// answer "has Perplexity moved while ChatGPT stood still?" without parsing
/// JSON in the database. This table is the per-engine grain the spec's
/// dashboard, alerts and trend detection all read; CheckupTrend stays as the
/// brand-level summary the existing chart already uses.
model VisibilityMetric {
  id             String   @id @default(cuid())
  brandProfileId String
  engine         String
  day            DateTime @db.Date

  /// 0-100, the weighted formula in src/lib/ai-monitor/metrics.ts.
  visibilityScore     Float
  /// WHICH formula produced `visibilityScore` — SCORE_VERSION in that module.
  /// Rows are NEVER recomputed when the weights change: a new version is
  /// written beside the old, and a row keeps the number the customer was shown
  /// on the day. A trend line that silently restates last quarter is worse than
  /// no trend line, because nothing on the chart says it happened.
  scoreVersion        Int     @default(1)
  /// Share of runs that cited any source supporting the brand. NULL — not 0 —
  /// on an engine that does not return citations at all.
  citationScore       Float?
  recommendationScore Float
  /// Mean sentiment, -1..1.
  sentimentScore      Float?
  /// 0-100. The brand's prominence as a share of all entities named.
  shareOfVoice        Float?
  /// Mean list position across runs that ranked the brand. Null when none did.
  averagePosition     Float?
  /// FRACTIONS, 0-1 — not percentages. `visibilityScore` and the component
  /// scores beside it are 0-100, so the two conventions sit on one row; the
  /// writer (toVisibilityMetricRow) is the single place that decides which is
  /// which, and a chart multiplying the wrong one by 100 is a silent 100x.
  mentionRate         Float
  top3Rate            Float
  /// Runs this row was computed from. A score off two runs and one off two
  /// hundred should not be read the same way, and the chart dims the former.
  runCount            Int     @default(0)
  /// True when the checkup behind this row did not complete its whole plan —
  /// runs were skipped at the spend cap or failed upstream. The score is still
  /// the best available answer, but it is NOT comparable to a full day's, and a
  /// trend line that dips because we asked less must say so rather than letting
  /// the customer read it as lost visibility.
  partialCoverage     Boolean @default(false)
  /// Planned runs that produced no answer. `runCount` counts the ones that did,
  /// so runCount + skippedRuns is the size of the plan.
  skippedRuns         Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandProfile BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  /// The rollup upserts, so a re-run cannot double a day.
  @@unique([brandProfileId, engine, day])
  @@index([brandProfileId, day(sort: Desc)])
  @@map("visibility_metrics")
}

/// A domain that AI answers cite, aggregated across every run for one project.
///
/// PER PROJECT, not global. The same domain is a different asset to different
/// brands: g2.com citing four of your competitors and none of you is a specific,
/// actionable gap for you and a non-event for the brand it already features.
model Source {
  id             String @id @default(cuid())
  tenantId       String
  brandProfileId String

  domain                String
  /// Total citations of this domain across the project's runs.
  citationCount         Int      @default(0)
  /// Distinct brand/competitor names whose claims this domain has supported.
  brandsSupported       String[] @default([])
  /// Citations supporting the brand, and supporting any competitor. The ratio
  /// is what makes a citation opportunity: high competitor, zero brand.
  ///
  /// `brandCitations > 0` IS "cites you" — there is deliberately no citesYou
  /// boolean. It would be a pure function of this column, and a stored copy is
  /// an invariant the aggregator could break: a re-run that recounted the
  /// citations but forgot the flag would leave a row asserting both at once.
  /// The read model derives it; see src/lib/citations/read.ts.
  brandCitations        Int      @default(0)
  competitorCitations   Int      @default(0)
  /// { "<rival name>": <citations> } — the per-rival split that
  /// `competitorCitations` totals and `brandsSupported` only names. This is the
  /// column that makes "who does this source cite instead of you" answerable,
  /// which is the whole point of the Citation Finder's preset filter.
  citesCompetitors      Json     @default("{}")
  /// How many distinct engines cite it. A domain three engines trust is worth
  /// more than one cited three times by the same engine.
  distinctEngines       Int      @default(0)
  /// { "<engine>": <citations> } — the engine breakdown `distinctEngines` only
  /// counts. Kept in lockstep with it by the aggregator (distinctEngines is
  /// this object's key count) rather than replacing it: the Int is what an
  /// index can sort on, and dropping a populated column to store the same fact
  /// twice as slowly is not an improvement. Citation Finder renders the keys.
  enginesSeen           Json     @default("{}")
  /// Citations arising from prompts with commercialValue >= the threshold in
  /// src/lib/ai-monitor/influence.ts.
  commercialPromptCount Int      @default(0)

  /// 0-100. From the SEO API adapter where available, else the heuristic in
  /// influence.ts. Null means neither could speak — which the influence score
  /// treats as a neutral midpoint rather than as zero, so an unrated domain is
  /// not silently ranked below a bad one.
  authorityScore    Float?
  topicalCategories String[]   @default([])
  sourceType        SourceType @default(OTHER)
  /// What kind of publication this domain is. See CitationKind for why this
  /// sits beside sourceType rather than replacing it.
  kind              CitationKind @default(OTHER)

  /// citationFrequency x distinctEngines x commercialPromptCount x authority.
  /// Stored so the ranked list is an index scan, recomputed by the aggregator.
  influenceScore Float @default(0)

  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandProfile BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  citations       Citation[]
  recommendations Recommendation[]

  @@unique([brandProfileId, domain])
  @@index([brandProfileId, influenceScore(sort: Desc)])
  /// Citation Finder's default order. influenceScore is not a substitute: this
  /// feature never writes it, so ordering the table by it would put every row
  /// this aggregator created at 0 and sort them by cuid.
  @@index([brandProfileId, citationCount(sort: Desc)])
  @@index([tenantId, domain])
  @@map("sources")
}

/// How much work getting listed on a source is. Three bands, not a 1-5 float:
/// the input is a `kind` lookup with seven possible answers, so a continuous
/// scale would be three distinct values wearing a decimal point.
enum OpportunityEffort {
  LOW
  MED
  HIGH
}

/// The customer's own state on one opportunity. `DONE` and `DISMISSED` both
/// remove it from the worklist; only DONE is watched for the citation flip.
enum OpportunityStatus {
  OPEN
  IN_PROGRESS
  DONE
  DISMISSED
}

/// One "get listed here" job, derived weekly from `sources`.
///
/// KEYED (tenantId, domain), NOT (brandProfileId, domain) like `sources`.
/// Deliberate and not an oversight: getting onto g2.com is ONE piece of work
/// however many brand profiles a tenant tracks, and a row per profile would
/// hand the customer the same task three times with three different scores.
/// The scorer therefore aggregates every `sources` row for the domain up to
/// the tenant grain before it writes here — see src/lib/citation-opportunities.
///
/// NO citesYou COLUMN, for the reason `sources` gives at length: it is
/// `brandCitations > 0` on the rows this was derived from, and a stored copy is
/// an invariant a re-run could break. The "proof" badge on a DONE row is that
/// same predicate, evaluated at read time.
model CitationOpportunity {
  id       String @id @default(cuid())
  tenantId String

  /// Registrable domain, the same normalisation `sources` and `citations` use.
  domain String

  /// log(1 + citations) x distinct engines x rival citations. The scale is
  /// arbitrary and only meaningful against its siblings, which is why the UI
  /// ranks rather than printing it.
  impact Float
  /// impact / effort weight. Stored so the worklist is an index scan, and so
  /// the order the customer sees cannot drift from the order that produced the
  /// p75 cut the notification fired on.
  priority Float
  effort   OpportunityEffort

  /// What kind of publication this is, carried over from `sources`. Here for
  /// ONE reason: it is the key into the localized how-to templates, so without
  /// it a French dashboard could only render the English `howTo` below.
  kind CitationKind @default(OTHER)
  /// English how-to, written by the weekly job from a heuristic template.
  ///
  /// A FALLBACK, exactly like Notification.title: the UI renders from the
  /// localized template catalog keyed on `kind`, and reads this only for a row
  /// whose kind the catalog does not know. Stored anyway because it is what an
  /// API consumer or an export gets, and because it records what the customer
  /// was actually told the week the row was written.
  howTo String @db.Text
  /// The brand's own topic this row's pitch template interpolates, when its
  /// kind has one. Null for kinds whose template needs no theme.
  theme String?

  status OpportunityStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, domain])
  /// The worklist's only order: this tenant's rows, best first.
  @@index([tenantId, priority(sort: Desc)])
  @@map("citation_opportunities")
}

/// One prioritised action, with the evidence that produced it.
///
/// EVIDENCE IS NOT OPTIONAL. A recommendation a customer cannot audit is a
/// horoscope: the "Why competitors win" card is rendered entirely from this
/// JSON, so a generator that cannot produce evidence must not produce a row.
model Recommendation {
  id             String @id @default(cuid())
  tenantId       String
  brandProfileId String

  type            RecommendationType
  /// Short imperative title: "Create a Foo vs Bar comparison page".
  title           String
  /// What to do, concretely — the slug to create, the entities to strengthen.
  suggestedAction String               @db.Text
  /// Estimated visibility points gained, 0-100.
  estimatedImpact Float
  /// 1 (an afternoon) to 5 (a quarter). The denominator of the priority.
  effort          Float
  /// estimatedImpact / effort. Stored so the list sorts on an index.
  priority        Float
  /// HIGH | MEDIUM | LOW, banded from `priority` at write time so the badge
  /// and the sort order can never disagree.
  priorityBand    String
  /// { prompts: [...], competitors: [...], sources: [...], reasons: [...] } —
  /// the numbered "why" list, verbatim.
  evidence        Json
  status          RecommendationStatus @default(OPEN)

  /// The prompt or source this finding is about, when it is about one.
  promptId String?
  sourceId String?

  /// Stable identity of the FINDING, not of the row: type + prompt/source +
  /// competitor. A nightly regeneration upserts on this, so an unchanged gap
  /// keeps its id, its status and any note a customer left on it instead of
  /// reappearing every morning as a brand-new task.
  dedupeKey String @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  dismissedAt DateTime?

  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandProfile BrandProfile   @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  prompt       TrackedPrompt? @relation(fields: [promptId], references: [id], onDelete: SetNull)
  source       Source?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  experiments Experiment[]

  @@index([brandProfileId, status, priority(sort: Desc)])
  @@index([tenantId, createdAt])
  @@map("recommendations")
}

/// Did acting on a recommendation actually move the number?
///
/// The baseline is SNAPSHOTTED onto the row at the start, for the same reason
/// Checkup copies its tier shape: the comparison has to be against what was
/// true when the experiment began, not against whatever the rollup says today.
model Experiment {
  id               String  @id @default(cuid())
  tenantId         String
  brandProfileId   String
  promptId         String
  recommendationId String?

  status     ExperimentStatus @default(RUNNING)
  hypothesis String           @db.Text

  /// { runs, mentions, top3, mentionRate, top3Rate, visibilityScore } as of
  /// the start. Frozen.
  baseline Json
  /// The same shape, as of the last evaluation.
  result   Json?

  /// Two-proportion z-test on the mention rate, baseline vs current.
  pValue     Float?
  /// Set when pValue crosses the threshold in experiments.ts AND the direction
  /// is an improvement. A significant DROP is not a success.
  successful Boolean?

  startedAt   DateTime  @default(now())
  /// When the experiment stops accruing runs. Null = open-ended.
  endsAt      DateTime?
  evaluatedAt DateTime?
  endedAt     DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brandProfile   BrandProfile    @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  prompt         TrackedPrompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  recommendation Recommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([brandProfileId, status])
  @@index([tenantId, startedAt])
  @@map("experiments")
}

// ─── In-app notifications ────────────────────────────────────────────────────

/// The durable in-app record of an alert. One row per alert-worthy event, fanned
/// in from every alert-producing surface (see src/lib/notifications/adapters.ts).
///
/// TENANT-SCOPED, NOT USER-SCOPED, and that is deliberate: not one of the seven
/// alert sources knows which user an alert is for — they all resolve recipients
/// at send time from tenant membership. `userId` exists for a future source that
/// genuinely targets one person; null means "everyone on this tenant".
///
/// READ STATE LIVES IN NotificationRead, NEVER ON THIS ROW. A `readAt` column
/// here would mean the first teammate to open the page clears the badge for the
/// whole tenant — the exact flaw EscalationAlert.acknowledged already has. Do
/// not add one.
///
/// `title`/`body` are stored in English as written by the emitting worker. They
/// are a FALLBACK ONLY, for a `type` the display catalog does not know. Rendering
/// goes through `type` + `payload` against the three dashboard catalogs, so a
/// French user does not read English alert text. New emissions must always carry
/// a typed payload — see NotificationPayloads in src/lib/notifications/types.ts.
model Notification {
  id       String  @id @default(cuid())
  tenantId String
  /// Null = tenant-wide (every current source). Set only by a source that
  /// targets one person.
  userId   String?

  /// NotificationType in src/lib/notifications/types.ts — the catalog key.
  type     String
  /// "info" | "warning" | "critical".
  severity String

  /// English fallback, rendered only when `type` is absent from the catalog.
  title String
  body  String? @db.Text

  /// Deep link to the tool page that explains the alert, e.g. "/visibility".
  href String

  /// Typed per `type`. What the catalog interpolates when rendering.
  payload Json?

  /// "<sourceModel>:<id>" of the row this was fanned in from, e.g.
  /// "AlertEvent:clx…". Null for sources that store nothing of their own
  /// (visibility_score_drop, reputation_score_change).
  sourceRef String?

  /// Per source+subject+day. Makes a retried sweep idempotent, exactly as the
  /// AlertEvent.dedupeKey it usually mirrors.
  dedupeKey String @unique

  createdAt DateTime @default(now())

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reads  NotificationRead[]

  /// The page read: this tenant's notifications, newest first.
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, type, createdAt(sort: Desc)])
  @@index([tenantId, severity, createdAt(sort: Desc)])
  @@map("notifications")
}

/// One row per (notification, user) that has read it. Absence means unread.
///
/// Read state is per user because a tenant-wide notification is delivered to
/// every member and each of them reads it separately. The unread badge counts
/// notifications with no row here for the current user.
model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  /// Marking read twice is a no-op, not a duplicate row.
  @@unique([notificationId, userId])
  /// The badge read: "which of these has this user already seen".
  @@index([userId, notificationId])
  @@map("notification_reads")
}

/// Which AI assistant sent a visitor. Mirrors AI_VISIT_SOURCES in
/// src/lib/attribution/sources.ts — adding a value here means adding a rule
/// there, and the classification tests assert the two lists agree.
///
/// `dark_ai` is the residual, not a fallback: it means "we proved this was an
/// AI assistant but not one of the five we report on individually" (You.com,
/// Poe, Meta AI, …). Traffic we cannot prove is AI is never stored at all.
enum AiVisitSource {
  chatgpt
  perplexity
  gemini
  copilot
  claude
  dark_ai
}

/// PUBLISHABLE site key for the attribution snippet: `er_pub_<id>.<secret>`.
///
/// Deliberately NOT a row in api_keys. That table holds er_api_ bearer keys,
/// which are server-side secrets granting READ access to /api/public/v1/*.
/// This key is pasted into a <script src> on a public page and is therefore
/// visible to anyone who views source; its only capability is appending a visit
/// row to its own tenant. Separate tables mean verifyApiKey() structurally
/// cannot resolve a publishable key, and vice versa.
///
/// The secret is still SHA-256'd at rest and confirmed in constant time — it
/// buys little for a key that is public by construction, but it keeps one habit
/// across both key classes. See src/lib/attribution/keys.ts.
model AttributionKey {
  id         String    @id @default(cuid())
  tenantId   String
  /// Human label, e.g. "example.com" or "marketing site".
  label      String
  /// SHA-256 (hex) of the secret segment. Never store plaintext.
  keyHash    String    @unique
  /// First 8 chars of the public id segment, surfaced for identification.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("attribution_keys")
}

/// One AI-referred visitor, per landing page, per source.
///
/// NOT an event log. The natural key below collapses a visitor's repeat arrivals
/// on the same page from the same assistant into one row, so the table grows
/// with distinct (visitor, page, source) rather than with traffic. firstSeen is
/// written once and never moved; lastSeen and hits are what the upsert touches.
/// That is what makes the 28-day trend "new AI-referred visitors per day" — an
/// honest number — rather than a page-view count dressed up as one.
///
/// visitorId is the value of the first-party `er_vid` cookie the snippet sets on
/// the CUSTOMER's domain. It is opaque and random: no IP, no fingerprint, no
/// cross-site identity. We never see it on any domain but the one that set it.
///
/// Phase 1 stores arrivals only. Conversions and revenue are P2/P3 and this
/// model deliberately carries no column for either.
model AiVisit {
  id          String        @id @default(cuid())
  tenantId    String
  /// Opaque first-party visitor id from the `er_vid` cookie.
  visitorId   String
  source      AiVisitSource
  /// Path only — no query, no fragment. "/pricing", never "/pricing?utm_x=y".
  landingPath String
  /// Referrer as origin+path. Query stripped: it carries search terms and
  /// occasionally session tokens, and we have no use for either.
  referrer    String?
  /// The utm_* parameters present on the landing URL, verbatim. Absent keys are
  /// omitted rather than stored null.
  utm         Json?
  firstSeen   DateTime      @default(now())
  lastSeen    DateTime      @default(now())
  /// Arrivals collapsed into this row. Starts at 1.
  hits        Int           @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The upsert target. Tenant-first so the constraint is also the isolation
  /// boundary: a collector write can only ever land inside its own tenant.
  @@unique([tenantId, visitorId, source, landingPath])
  /// The dashboard read: this tenant's last 28 days, newest first.
  @@index([tenantId, firstSeen(sort: Desc)])
  /// Source breakdown and landing-page table over the same window.
  @@index([tenantId, source, firstSeen(sort: Desc)])
  @@map("ai_visits")
}

// ─────────────────────────────────────────────────────────────
// AI SHARE OF VOICE — who owns the answers, per engine, per day
//
// Built ON the Watcher run data (PromptRun → MentionAnalysis / CompetitorMention)
// and writing only here. Nothing in src/lib/ai-monitor/ is modified by this
// feature; the aggregator imports from it and writes this table.
// ─────────────────────────────────────────────────────────────

/// One entity's share of one engine's answers, for one prompt set, on one day.
///
/// THE PROMPT SET IS A BrandProfile. There is no PromptSet entity in this
/// schema and adding one would have meant a second project identity beside the
/// one TrackedPrompt already points at: a "prompt set" is exactly the selected,
/// active prompts hanging off a brand profile. `promptSetId` is therefore a FK
/// to BrandProfile, named for the concept the SoV product speaks in rather than
/// for the table, because the two are the same row and the report is about the
/// set of questions, not about the brand that owns them.
///
/// `brand` IS THE UNIVERSE, NOT THE CUSTOMER. One row exists for every entity
/// observed in the window — the tracked brand and every rival named beside it —
/// which is what makes `share` a distribution that sums to 1 across the rows of
/// a (promptSet, engine, date) group rather than a single number floating on
/// its own. A table holding only the customer's own share could never answer
/// "who took it", which is the whole question.
///
/// DISTINCT FROM VisibilityMetric.shareOfVoice, deliberately. That column is
/// the brand's appearances as a percentage of all appearances in ONE checkup's
/// runs — unweighted, brand-only, and scoped to the day a checkup ran. This is
/// a rank-weighted distribution over a 28-day rolling window with a row per
/// competitor. Both are honest answers to different questions, and neither is
/// computed from the other; the older column is untouched.
model SovSnapshot {
  id String @id @default(cuid())

  tenantId    String
  /// BrandProfile.id. See the note above on why this is not its own entity.
  promptSetId String
  /// Provider id as stored on PromptRun.engine, upper-cased by the aggregator
  /// so the legacy lowercase "claude" rows from the pre-checkup scheduler do
  /// not form a second engine beside "CLAUDE".
  engine      String
  /// UTC day the window CLOSED on — the snapshot's as-of date, not the day the
  /// runs happened. Twenty-eight days of runs roll up into one dated row.
  date        DateTime @db.Date

  /// The observed entity, in the casing it was first seen in. Grouped
  /// case-insensitively by the aggregator, exactly as topCompetitors() in
  /// src/lib/ai-monitor/metrics.ts groups rivals, so the two panels cannot
  /// disagree about how many rivals there are.
  brand String

  /// Sum of this entity's per-observation rank weights across the window.
  /// 1/rank capped at the top 5, 0.3 for a mention with no position. NOT a
  /// count: two first-place mentions and five sixth-place ones are different
  /// facts and a count cannot tell them apart.
  mentionWeighted Float
  /// Distinct prompts the window's observations came from, for this
  /// (promptSet, engine). THE SAME NUMBER ON EVERY ROW OF A GROUP — it
  /// describes the sample, not the entity, and a share computed off four
  /// prompts should not be read like one computed off forty.
  promptCount     Int
  /// mentionWeighted / (sum of mentionWeighted across the group). 0..1, and the
  /// rows of one (promptSet, engine, date) group sum to 1.
  share           Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  promptSet BrandProfile @relation(fields: [promptSetId], references: [id], onDelete: Cascade)

  /// The nightly writer upserts on this, so re-running a night restates it
  /// rather than doubling it — same contract as VisibilityMetric's key.
  @@unique([promptSetId, engine, date, brand])
  /// The page read: one prompt set's window, newest first.
  @@index([promptSetId, date(sort: Desc)])
  /// The week-over-week drop check, and every tenant-scoped read.
  @@index([tenantId, date(sort: Desc)])
  @@map("sov_snapshots")
}

/// One "why are they winning?" report: a ranked, evidence-backed comparison of
/// one rival against the tenant's own brand, assembled from six gatherers.
///
/// HISTORY, NOT A CACHE ROW. Keyed (tenantId, rivalDomain, createdAt) and
/// appended to, rather than upserted on (tenantId, rivalDomain). The 7-day
/// re-run window reads the NEWEST row and checks its age, which an upsert would
/// serve equally well — but an upsert would also destroy the only record of
/// what the gap looked like last month, which is the second question every
/// customer asks. Each row also cost real money upstream; overwriting a
/// paid-for observation to save a few kilobytes is a bad trade.
model ExplainReport {
  id       String @id @default(cuid())
  tenantId String

  /// Registrable domain, via src/lib/registrable-domain.ts — the same
  /// normalisation `sources` and `citations` use, so a rival's own citation
  /// rows join to this without a second spelling of the same company.
  rivalDomain String
  /// The rival as the engines actually spelled it ("Otterly.AI"), which is the
  /// key `sources.citesCompetitors` and `sov_snapshots.brand` carry. Stored
  /// beside the domain because neither is derivable from the other.
  rivalName String
  /// The BrandProfile this comparison ran against. A tenant tracking two
  /// profiles gets two different answers about the same rival, and a report
  /// that could not say which one produced it would be unreadable.
  brandProfileId String

  /// Ranked ExplainFactor[] — the shape is in src/lib/explain/types.ts. JSON
  /// rather than a child table because the array is written once, read whole,
  /// and never queried by element: a factors table would buy a join and
  /// nothing else.
  factors Json

  /// USD this run actually spent upstream — the sum of the SeoApiCall rows it
  /// wrote. Recorded here as well so a report can state its own cost without a
  /// correlated query against a table that has no foreign key back to it, and
  /// so a cached report still shows what it originally cost to produce.
  costUsd Decimal @db.Decimal(10, 6)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// The freshness read, and the only one: newest report for one rival, one
  /// tenant. Covers the report-view fetch and the 7-day staleness check both.
  @@index([tenantId, rivalDomain, createdAt(sort: Desc)])
  @@map("explain_reports")
}

// ─── Agency Opportunity Scanner ──────────────────────────────────────────────

/// Where one prospect got to in a scan.
///
/// `failed` is a first-class outcome, not an error state to clean up. A cold
/// prospect list contains parked domains, dead hosts and WAFs that refuse an
/// unknown user agent, and an agency needs to see which ones those were —
/// "we could not reach this site" is itself a sales signal, and silently
/// dropping the row would make the batch's totals lie.
enum ScanRowStatus {
  queued
  running
  done
  failed
}

/// One bulk prospect scan: a pasted list or an uploaded CSV, and its progress.
///
/// AGENCY-ONLY, and gated with requireFeature("whitelabel") — the AGENCY+ line
/// in PLAN_FEATURES, and the honest key here because the deliverable this whole
/// tool exists to produce is a white-labeled outreach PDF. See
/// src/lib/opportunity-scanner/quota.ts for the monthly batch ceiling.
///
/// THIS TABLE HOLDS DOMAINS THE TENANT DOES NOT OWN. Every other domain-shaped
/// column in this schema is a site the tenant registered and we verified; these
/// are strangers' sites, typed in bulk. That difference is why the ingest path
/// runs each one through the SSRF guard before a row is ever written, and why
/// nothing downstream may treat a ScanRow.domain as trusted input.
model ScanBatch {
  id       String @id @default(cuid())
  tenantId String

  status ScanBatchStatus @default(running)

  /// Rows accepted at submit, after normalisation, dedupe and SSRF rejection.
  /// The denominator the UI shows; NOT the number of lines pasted.
  total Int
  /// Rows that have reached a terminal state — done OR failed. Incremented by
  /// the worker, and the completion notification fires when it reaches `total`.
  done  Int @default(0)

  /// Whether this batch buys a Places lookup per domain.
  ///
  /// OFF BY DEFAULT and stored per batch rather than per tenant, because it is
  /// the only thing here that spends money and the decision is made per list:
  /// a list of local businesses is worth the lookup, a list of SaaS companies
  /// is a thousand calls that all return nothing. The estimate shown at submit
  /// is computed from this flag and the accepted row count.
  placesEnabled Boolean @default(false)

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows   ScanRow[]

  /// The batch list: this tenant's scans, newest first.
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("scan_batches")
}

/// The batch's own lifecycle, distinct from any individual row's.
enum ScanBatchStatus {
  running
  complete
}

/// One prospect domain inside a batch.
model ScanRow {
  id      String @id @default(cuid())
  batchId String

  /// Registrable domain, lowercased — the output of registrableDomain(), which
  /// is also what the dedupe at submit is keyed on.
  domain String

  /// 0-100 from the sidecar's passive audit. NULL until the row runs, and
  /// permanently NULL for a row that failed — which is why it is nullable and
  /// the grade below is not defaulted.
  score Int?
  /// A-F, banded from `score` at write time.
  ///
  /// STORED, NOT DERIVED ON READ. The batch table is sorted by it and a CSV
  /// export prints it, so recomputing on every read would make the band
  /// definition a thing two code paths have to agree about forever. Null for
  /// a row that never scored.
  grade String? @db.Char(1)

  /// The three checks that lost the most points, as
  /// [{category, status, recommendation, lost}]. Denormalised out of the audit
  /// response because it is the only part of it the outreach PDF and the CSV
  /// need, and keeping the whole audit would make this table the largest in the
  /// schema for data nobody reads twice.
  topGaps Json?

  /// Google Places standing, when the batch bought it: {rating, reviewCount}.
  /// Null when placesEnabled was off, when no listing matched, or when the cap
  /// stopped the call — three different silences that all render the same way,
  /// which is correct: the report says nothing rather than guessing.
  place Json?

  status ScanRowStatus @default(queued)
  /// Why a failed row failed, in English, for the agency to read. Not shown to
  /// the prospect and never rendered into a PDF.
  error  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  batch ScanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// One row per domain per batch. The submit path dedupes before insert; this
  /// is the backstop that makes a double-submit idempotent rather than
  /// doubling the batch.
  @@unique([batchId, domain])
  /// The batch table's only order: worst grade first, so the best prospects to
  /// call are at the top. Nulls (failed rows) sort last on read, not here.
  @@index([batchId, grade])
  @@map("scan_rows")
}
