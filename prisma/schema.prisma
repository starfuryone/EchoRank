generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum PlanType {
  AI_VISIBILITY
  STARTER
  GROWTH
  AGENCY
  ENTERPRISE
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum FeedbackStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

enum CustomerStatus {
  NEW
  CONTACTED
  SATISFIED
  NEEDS_FOLLOWUP
  RECOVERED
  LOST
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
}

model User {
  id              String           @id @default(cuid())
  name            String?
  email           String           @unique
  emailVerified   DateTime?
  passwordHash    String?
  image           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  memberships     TenantMember[]
  accounts        Account[]
  sessions        Session[]
  auditLogs       AuditLog[]
  extensionTokens ExtensionToken[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Tenant {
  id                    String        @id @default(cuid())
  name                  String
  slug                  String        @unique
  logo                  String?
  brandPrimaryColor     String        @default("#2563eb")
  brandSecondaryColor   String        @default("#1e40af")
  supportEmail          String?
  googleReviewLink      String?
  facebookReviewLink    String?
  trustpilotLink        String?
  defaultLanguage       String        @default("en")
  timezone              String        @default("America/New_York")
  planType              PlanType      @default(STARTER)
  monthlyRequestLimit   Int           @default(300)
  billingStatus         BillingStatus @default(TRIALING)
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  whitelabel            Boolean       @default(false)
  customDomain          String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  welcomeSeenAt         DateTime?
  onboardingDismissedAt DateTime?
  onboardingIntent      String? // "business" | "agency"
  auditDomain           String? // domain captured from the landing audit widget or the welcome modal
  onboarding            Json? // { pdfDownloadedAt?, roadmapViewedAt?, firstAuditScore?, firstAuditAt?, profileCompletedAt? }
  marketingConsent      Boolean       @default(true)

  members            TenantMember[]
  visibilityMonitors VisibilityMonitor[]
  visibilityAudits   VisibilityAudit[]
  trackedPrompts     TrackedPrompt[]
  promptRuns         PromptRun[]
  customers          Customer[]
  feedback           Feedback[]
  reviewLinks        ReviewLink[]
  emailTemplates     EmailTemplate[]
  smsTemplates       SmsTemplate[]
  recoveryTickets    RecoveryTicket[]
  emailLogs          EmailLog[]
  smsLogs            SmsLog[]
  campaigns          Campaign[]
  subscription       Subscription?
  auditLogs          AuditLog[]
  domainEvents       DomainEvent[]
  usageMeters        UsageMeter[]
  usageSnapshots     UsageSnapshot[]
  quota              TenantQuota?
  retentionPolicy    DataRetentionPolicy?
  deletionLogs       DeletionLog[]
  reputationScores   ReputationScore[]
  aiAnalyses         AiAnalysis[]
  escalationAlerts   EscalationAlert[]
  monitoringSources  MonitoringSource[]
  externalReviews    ExternalReview[]
  importJobs         ImportJob[]
  extensionTokens    ExtensionToken[]
  apiKeys            ApiKey[]
  gscConnection      GscConnection?
  gscQueryStats      GscQueryStat[]

  @@map("tenants")
}

model TenantMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_members")
}

model Customer {
  id              String           @id @default(cuid())
  tenantId        String
  name            String
  email           String?
  phone           String?
  status          CustomerStatus   @default(NEW)
  tags            String[]
  location        String?
  metadata        Json?
  deletedAt       DateTime?
  archivedAt      DateTime?
  legalHold       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback        Feedback[]
  emailLogs       EmailLog[]
  smsLogs         SmsLog[]
  recoveryTickets RecoveryTicket[]

  @@index([tenantId])
  @@index([tenantId, email])
  @@map("customers")
}

model Feedback {
  id             String          @id @default(cuid())
  tenantId       String
  customerId     String
  campaignId     String?
  rating         Int?
  comment        String?
  status         FeedbackStatus  @default(PENDING)
  token          String          @unique
  submittedAt    DateTime?
  routedAt       DateTime?
  expiresAt      DateTime?
  deletedAt      DateTime?
  legalHold      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  campaign       Campaign?       @relation(fields: [campaignId], references: [id])
  reviewRequest  ReviewRequest?
  recoveryTicket RecoveryTicket?

  @@index([tenantId])
  @@index([token])
  @@index([tenantId, status])
  @@index([tenantId, rating])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerId])
  @@index([tenantId, campaignId])
  @@index([status, routedAt])
  @@map("feedback")
}

model ReviewLink {
  id        String   @id @default(cuid())
  tenantId  String
  platform  String
  url       String
  label     String?
  location  String?
  isDefault Boolean  @default(false)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("review_links")
}

model ReviewRequest {
  id         String    @id @default(cuid())
  feedbackId String    @unique
  platform   String
  url        String
  clicked    Boolean   @default(false)
  clickedAt  DateTime?
  sentAt     DateTime  @default(now())
  feedback   Feedback  @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@map("review_requests")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  body      String
  type      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("email_templates")
}

model SmsTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  body      String
  type      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sms_templates")
}

model RecoveryTicket {
  id         String         @id @default(cuid())
  tenantId   String
  customerId String
  feedbackId String         @unique
  status     TicketStatus   @default(OPEN)
  priority   TicketPriority @default(MEDIUM)
  assignedTo String?
  notes      String?
  resolvedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  feedback   Feedback       @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, createdAt])
  @@map("recovery_tickets")
}

model EmailLog {
  id                String         @id @default(cuid())
  tenantId          String
  customerId        String
  to                String
  subject           String
  body              String
  status            MessageStatus  @default(QUEUED)
  channel           MessageChannel @default(EMAIL)
  // Brevo's message-id (Message-Id header it assigns at relay time). Captured
  // at send for debugging/joins. NOTE: Brevo's SMTP relay rewrites Message-Id,
  // so this is NOT a reliable webhook-correlation key on its own — webhook
  // correlation uses the X-Mailin-custom token carrying this row's id instead.
  providerMessageId String?
  // Lifecycle timestamps populated by Brevo webhook events.
  openedAt          DateTime?
  clickedAt         DateTime?
  bouncedAt         DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime       @default(now())
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([customerId, tenantId])
  @@index([providerMessageId])
  @@map("email_logs")
}

model SmsLog {
  id                String        @id @default(cuid())
  tenantId          String
  customerId        String
  to                String
  body              String
  status            MessageStatus @default(QUEUED)
  // Brevo SMS message-id returned by the send API. Unlike email, the SMS API
  // response id matches the webhook's message id, so this IS the correlation key.
  providerMessageId String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorMessage      String?
  createdAt         DateTime      @default(now())
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([providerMessageId])
  @@map("sms_logs")
}

model Campaign {
  id             String         @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  channel        MessageChannel @default(EMAIL)
  status         CampaignStatus @default(DRAFT)
  location       String?
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  totalSent      Int            @default(0)
  totalResponses Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feedback       Feedback[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("campaigns")
}

model Subscription {
  id                   String        @id @default(cuid())
  tenantId             String        @unique
  planType             PlanType
  status               BillingStatus @default(TRIALING)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean       @default(false)
  stripeSubscriptionId String?
  stripePriceId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  tenant               Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, entity])
  @@map("audit_logs")
}

// ─── PHASE 2: Domain Events ────────────────────────────────────────────

enum DomainEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model DomainEvent {
  id            String            @id @default(cuid())
  tenantId      String
  eventType     String
  eventVersion  Int               @default(1)
  aggregateType String
  aggregateId   String
  payload       Json
  metadata      Json?
  status        DomainEventStatus @default(PENDING)
  correlationId String?
  causationId   String?
  retryCount    Int               @default(0)
  maxRetries    Int               @default(3)
  processedAt   DateTime?
  failedAt      DateTime?
  error         String?
  createdAt     DateTime          @default(now())
  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, eventType, aggregateId, correlationId], name: "event_idempotency_key")
  @@index([tenantId])
  @@index([eventType])
  @@index([status])
  @@index([correlationId])
  @@index([createdAt])
  @@index([tenantId, eventType])
  @@index([tenantId, createdAt])
  @@map("domain_events")
}

// ─── PHASE 4: Usage Metering ───────────────────────────────────────────

enum MeterType {
  EMAIL_SENT
  SMS_SENT
  WEBHOOK_CALL
  API_REQUEST
  AI_TOKEN_USAGE
  AI_INFERENCE
  REVIEW_CONVERSION
  ESCALATION_EVENT
  FEEDBACK_REQUEST
  MONITORING_CHECK
}

model UsageMeter {
  id         String    @id @default(cuid())
  tenantId   String
  meterType  MeterType
  quantity   Int       @default(1)
  unitCost   Float     @default(0)
  metadata   Json?
  recordedAt DateTime  @default(now())
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, meterType])
  @@index([tenantId, recordedAt])
  @@map("usage_meters")
}

model UsageSnapshot {
  id                String   @id @default(cuid())
  tenantId          String
  periodStart       DateTime
  periodEnd         DateTime
  emailsSent        Int      @default(0)
  smsSent           Int      @default(0)
  webhookCalls      Int      @default(0)
  apiRequests       Int      @default(0)
  aiTokensUsed      Int      @default(0)
  aiInferences      Int      @default(0)
  aiCost            Float    @default(0)
  feedbackRequests  Int      @default(0)
  reviewConversions Int      @default(0)
  escalationEvents  Int      @default(0)
  monitoringChecks  Int      @default(0)
  totalCost         Float    @default(0)
  createdAt         DateTime @default(now())
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, periodStart, periodEnd])
  @@index([tenantId])
  @@map("usage_snapshots")
}

model TenantQuota {
  id                      String   @id @default(cuid())
  tenantId                String   @unique
  maxEmailsPerMonth       Int      @default(300)
  maxSmsPerMonth          Int      @default(0)
  maxWebhooksPerMonth     Int      @default(1000)
  maxApiRequestsPerDay    Int      @default(10000)
  maxAiInferencesPerMonth Int      @default(100)
  maxMonitoringChecks     Int      @default(0)
  overageAllowed          Boolean  @default(false)
  overageRateEmail        Float    @default(0.01)
  overageRateSms          Float    @default(0.05)
  overageRateAi           Float    @default(0.02)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  tenant                  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_quotas")
}

// ─── PHASE 5: Soft Delete & Compliance ─────────────────────────────────

model DataRetentionPolicy {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  feedbackRetentionDays Int      @default(730)
  customerRetentionDays Int      @default(1095)
  auditLogRetentionDays Int      @default(2555)
  eventRetentionDays    Int      @default(365)
  autoDeleteEnabled     Boolean  @default(false)
  gdprCompliant         Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("data_retention_policies")
}

model DeletionLog {
  id           String    @id @default(cuid())
  tenantId     String
  entityType   String
  entityId     String
  deletedBy    String?
  reason       String?
  legalHold    Boolean   @default(false)
  restorable   Boolean   @default(true)
  snapshotData Json?
  deletedAt    DateTime  @default(now())
  expiresAt    DateTime?
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("deletion_logs")
}

// ─── PHASE 6: AI Reputation Intelligence ───────────────────────────────

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

model ReputationScore {
  id                  String    @id @default(cuid())
  tenantId            String
  location            String?
  overallScore        Float
  sentimentScore      Float
  responseRateScore   Float
  recoveryScore       Float
  reviewVelocityScore Float
  volatilityIndex     Float     @default(0)
  riskLevel           RiskLevel @default(LOW)
  trendDirection      String    @default("stable")
  periodStart         DateTime
  periodEnd           DateTime
  sampleSize          Int       @default(0)
  confidence          Float     @default(0)
  createdAt           DateTime  @default(now())
  tenant              Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, location])
  @@index([tenantId, createdAt])
  @@map("reputation_scores")
}

model AiAnalysis {
  id                    String    @id @default(cuid())
  tenantId              String
  feedbackId            String?
  externalReviewId      String?
  analysisType          String
  sentimentLabel        String?
  sentimentScore        Float?
  escalationProbability Float?
  publicPostProbability Float?
  churnProbability      Float?
  riskLevel             RiskLevel @default(LOW)
  intent                String?
  entities              Json?
  emotions              Json?
  topics                Json?
  suggestedAction       String?
  confidence            Float     @default(0)
  modelId               String?
  promptTokens          Int       @default(0)
  completionTokens      Int       @default(0)
  latencyMs             Int       @default(0)
  createdAt             DateTime  @default(now())
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([feedbackId])
  @@index([analysisType])
  @@index([riskLevel])
  @@index([tenantId, createdAt])
  @@map("ai_analyses")
}

model EscalationAlert {
  id               String    @id @default(cuid())
  tenantId         String
  customerId       String?
  feedbackId       String?
  externalReviewId String?
  alertType        String
  riskLevel        RiskLevel
  probability      Float
  title            String
  description      String
  suggestedAction  String?
  acknowledged     Boolean   @default(false)
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, riskLevel])
  @@index([tenantId, acknowledged])
  @@map("escalation_alerts")
}

// ─── PHASE 7: External Reputation Monitoring ───────────────────────────

enum MonitoringPlatform {
  GOOGLE
  FACEBOOK
  TRUSTPILOT
  YELP
  REDDIT
  TWITTER
  TIKTOK
  YOUTUBE
  APP_STORE
  CUSTOM
}

model MonitoringSource {
  id            String             @id @default(cuid())
  tenantId      String
  platform      MonitoringPlatform
  externalId    String
  name          String
  url           String?
  credentials   Json?
  isActive      Boolean            @default(true)
  lastCheckedAt DateTime?
  checkInterval Int                @default(3600)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reviews       ExternalReview[]
  importJobs    ImportJob[]

  @@unique([tenantId, platform, externalId])
  @@index([tenantId])
  @@map("monitoring_sources")
}

model ExternalReview {
  id               String             @id @default(cuid())
  tenantId         String
  sourceId         String
  platform         MonitoringPlatform
  externalId       String
  authorName       String?
  authorUrl        String?
  rating           Float?
  content          String?
  language         String?
  publishedAt      DateTime?
  url              String?
  replyContent     String?
  repliedAt        DateTime?
  sentimentLabel   String?
  sentimentScore   Float?
  riskLevel        RiskLevel          @default(LOW)
  isProcessed      Boolean            @default(false)
  deduplicationKey String             @unique
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source           MonitoringSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, platform])
  @@index([tenantId, riskLevel])
  @@index([sourceId])
  @@index([publishedAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, sentimentLabel])
  @@map("external_reviews")
}

// ─── PHASE 3: Observability ────────────────────────────────────────────

model SystemMetric {
  id         String   @id @default(cuid())
  tenantId   String?
  metricName String
  value      Float
  tags       Json?
  recordedAt DateTime @default(now())

  @@index([metricName, recordedAt])
  @@index([tenantId, metricName])
  @@map("system_metrics")
}

// ─── Processed Webhooks (Stripe idempotency) ──────────────────────────

model ProcessedWebhook {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  eventType     String
  processedAt   DateTime @default(now())
  payload       Json?

  @@index([eventType])
  @@map("processed_webhooks")
}

// ─── Brevo (email/SMS) webhook events ─────────────────────────────────
// Brevo does not send a unique event id (unlike Stripe), so idempotency is
// enforced via a deterministic dedup key derived from the message id, event
// type, and event timestamp. The unique constraint makes replays no-ops, the
// same way ProcessedWebhook.stripeEventId does for Stripe.
model MessageEvent {
  id         String   @id @default(cuid())
  tenantId   String?
  channel    String // EMAIL | SMS
  event      String // delivered | opened | click | hard_bounce | ...
  recipient  String?
  messageId  String?
  emailLogId String?
  smsLogId   String?
  dedupeKey  String   @unique
  payload    Json?
  occurredAt DateTime
  receivedAt DateTime @default(now())

  @@index([tenantId])
  @@index([emailLogId])
  @@index([smsLogId])
  @@index([event])
  @@map("message_events")
}

// ─── Stripe multi-currency price catalog ───────────────────────────────
// One Stripe Price object exists per (tier, currency, interval). Rather than
// fanning these out as env vars (4 tiers x 5 currencies = 20), they are
// resolved from this table at checkout/webhook time. `active` lets old prices
// be retired without deletion; lookups always filter on active = true.
model StripePrice {
  id            String   @id @default(cuid())
  stripePriceId String   @unique @map("stripe_price_id")
  planTier      String   @map("plan_tier") // starter | growth | agency | enterprise
  currency      String // USD | EUR | GBP | CAD | CHF
  interval      String   @default("month") // month | year
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([planTier, currency, interval, active])
  @@map("stripe_prices")
}

// ─── Soft Delete Additions to Existing Models ──────────────────────────
// Note: deletedAt, archivedAt, legalHold fields are added to core models
// via the compliance middleware layer rather than schema changes, to avoid
// breaking the existing API. The DeletionLog table tracks all deletions.

// ─── CSV / file import jobs ────────────────────────────────────────────
// A multi-source ingestion record. Reviews uploaded via CSV (and, later,
// Excel/Sheets/Airtable) are attached to a synthetic MonitoringSource so they
// flow through the exact same normalize → dedup → AiAnalysis → reputation /
// escalation pipeline as platform-monitored reviews. This table is the import
// history + column-mapping wizard state machine, and (for v1) the staging
// store for the raw uploaded text between the preview and commit steps.
enum ImportStatus {
  PENDING_MAPPING // uploaded + parsed headers; awaiting column-mapping confirmation
  QUEUED // mapping confirmed; csv-import job enqueued
  PROCESSING // worker is ingesting rows
  COMPLETED // all rows ingested (some may have been duplicates)
  PARTIAL // completed, but one or more rows failed validation
  FAILED // job-level failure (parse error, etc.)
  CANCELLED // user discarded before commit
}

enum ImportSourceFormat {
  GENERIC_CSV
  GOOGLE_CSV
  FACEBOOK_CSV
  TRUSTPILOT_CSV
  EXCEL // reserved for the .xlsx slice (Feature 4); parsed to rows then shares this pipeline
  EXTENSION // browser-extension scraped import; rows arrive pre-structured as JSON
}

model ImportJob {
  id              String             @id @default(cuid())
  tenantId        String
  // The synthetic MonitoringSource these rows are attached to. Nullable so a
  // discarded (CANCELLED) or failed-at-parse import need not allocate a source.
  sourceId        String?
  filename        String
  format          ImportSourceFormat @default(GENERIC_CSV)
  // Platform the rows represent — drives the dedup namespace and dashboards.
  platform        MonitoringPlatform @default(CUSTOM)
  status          ImportStatus       @default(PENDING_MAPPING)
  // Raw uploaded text, retained for re-parse at commit time. Capped at the
  // route layer (see MAX_IMPORT_BYTES). For very large files this should move
  // to object storage; kept in-row for v1 since review exports are small.
  rawContent      String?            @db.Text
  hasHeaderRow    Boolean            @default(true)
  // Header names detected at parse time: string[].
  detectedColumns Json?
  // Confirmed mapping of canonical field -> source column, e.g.
  // { "rating": "Star Rating", "content": "Review", "author": "Name" }.
  columnMapping   Json?
  totalRows       Int                @default(0)
  importedRows    Int                @default(0)
  duplicateRows   Int                @default(0)
  failedRows      Int                @default(0)
  // Up to N row-level errors: [{ row: number, message: string }].
  errors          Json?
  errorMessage    String? // job-level failure reason
  createdById     String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source MonitoringSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([sourceId])
  @@map("import_jobs")
}

/// Long-lived API token issued to a logged-in user for the browser extension.
/// Only a SHA-256 hash of the secret is stored; the plaintext is shown once at
/// creation. Tokens are tenant-scoped, revocable, and rotatable (rotation =
/// revoke old + issue new, preserving label/scopes).
model ExtensionToken {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  /// Human label set at creation, e.g. "Chrome on work laptop".
  label      String
  /// SHA-256 (hex) of the token secret. Never store plaintext.
  tokenHash  String    @unique
  /// First 8 chars of the public token id, surfaced in the UI for identification.
  prefix     String
  /// Reserved for future per-token scoping (e.g. ["import:write"]).
  scopes     String[]  @default([])
  lastUsedAt DateTime?
  /// Optional hard expiry. Null = no expiry (revoke to disable).
  expiresAt  DateTime?
  /// Set when revoked; a non-null value disables the token.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([tokenHash])
  @@map("extension_tokens")
}

enum VisibilityCadence {
  DAILY
  WEEKLY
}

model VisibilityMonitor {
  id        String            @id @default(cuid())
  tenantId  String
  url       String
  cadence   VisibilityCadence @default(WEEKLY)
  active    Boolean           @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime          @default(now())
  // Snapshot of the last completed audit for cheap diffing + list views.
  lastScore Int?
  lastGrade String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  audits VisibilityAudit[]

  @@unique([tenantId, url])
  @@index([active, nextRunAt])
  @@map("visibility_monitors")
}

model VisibilityAudit {
  id        String   @id @default(cuid())
  tenantId  String
  monitorId String?
  url       String
  score     Int
  grade     String
  // checks[] and robots.bots snapshots from the sidecar, for diffing + trend UI.
  checks    Json
  bots      Json
  raw       Json?
  createdAt DateTime @default(now())

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  monitor VisibilityMonitor? @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([monitorId, createdAt])
  @@map("visibility_audits")
}

model TrackedPrompt {
  id        String    @id @default(cuid())
  tenantId  String
  text      String
  active    Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   PromptRun[]

  @@unique([tenantId, text])
  @@index([active, nextRunAt])
  @@map("tracked_prompts")
}

model PromptRun {
  id             String   @id @default(cuid())
  tenantId       String
  promptId       String
  engine         String   @default("claude")
  model          String
  brandMentioned Boolean
  brandRank      Int?
  // [{name, mentioned}] snapshot at run time.
  competitors    Json
  excerpt        String?  @db.Text
  error          String?
  createdAt      DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prompt TrackedPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([promptId, createdAt])
  @@map("prompt_runs")
}

// ─────────────────────────────────────────────────────────────
// SIGNAL SPINE — paste these two models into prisma/schema.prisma
// then: npx prisma db push  (or use prisma/migration.sql manually)
// If your tenant FK convention is different (e.g. organizationId),
// find/replace `tenantId` here AND in src/lib/signals/*.
// ─────────────────────────────────────────────────────────────

model Signal {
  id         String   @id @default(cuid())
  tenantId   String
  source     String // review | feedback | visibility | support | social | news | competitor | manual
  externalId String? // stable id in the source system (review id, audit id…)
  dedupeHash String   @unique
  entityType String? // location | customer | …
  entityId   String?
  occurredAt DateTime
  ingestedAt DateTime @default(now())
  sentiment  Float // -1..1
  severity   Float // 0..1
  magnitude  Float    @default(0.5) // 0..1 reach/weight of the signal
  title      String?
  body       String?  @db.Text
  url        String?
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([tenantId, source, occurredAt(sort: Desc)])
}

model RiskSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  day         DateTime @db.Date
  score       Int // 0..100, higher = more risk
  grade       String // A..F
  components  Json
  drivers     Json
  signalCount Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, day])
  @@index([tenantId, day(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────
// PHASE 2 — AlertEvent + TenantRiskConfig
// deploy-phase2.sh appends this automatically (with backup).
// ─────────────────────────────────────────────────────────────

model AlertEvent {
  id         String    @id @default(cuid())
  tenantId   String
  kind       String // risk_threshold | risk_spike | critical_signal
  severity   String // warning | critical
  title      String
  body       String?
  dedupeKey  String    @unique
  payload    Json?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([notifiedAt, createdAt])
}

model TenantRiskConfig {
  tenantId       String   @id
  monthlyRevenue Float?
  currency       String   @default("USD")
  riskElasticity Float    @default(0.10)
  alertEmails    String? // comma-separated; falls back to ALERT_FALLBACK_EMAIL
  alertsEnabled  Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
// PHASE 3 — Competitor + CompetitorSnapshot
// deploy-phase3.sh appends this automatically (with backup).
// ─────────────────────────────────────────────────────────────

model Competitor {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  placeId   String? // Google Places (v1) id → automated daily snapshots
  address   String? // formatted address / vicinity — disambiguates chains
  platform  String   @default("google")
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  snapshots CompetitorSnapshot[]

  @@unique([tenantId, placeId])
  @@index([tenantId, active])
}

model CompetitorSnapshot {
  id           String   @id @default(cuid())
  competitorId String
  day          DateTime @db.Date
  rating       Float?
  reviewCount  Int?
  raw          Json?
  createdAt    DateTime @default(now())

  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, day])
  @@index([competitorId, day(sort: Desc)])
}

/// Tenant-scoped public-API keys (SEO Tools "API access"). Mirrors the
/// ExtensionToken design: opaque bearer `er_api_<id>.<secret>`, SHA-256 of
/// the secret stored (never plaintext), instant revocation via revokedAt.
model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  /// Human label set at creation, e.g. "CI pipeline".
  label      String
  /// SHA-256 (hex) of the secret segment. Never store plaintext.
  keyHash    String    @unique
  /// First 8 chars of the public id segment, surfaced for identification.
  prefix     String
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

/// Google Search Console connection (SEO Tools "GSC Insights"). One per
/// tenant. The OAuth refresh token is stored AES-256-GCM-encrypted
/// (src/lib/gsc/crypto.ts, key derived from GSC_TOKEN_ENCRYPTION_KEY) —
/// never in plaintext, never logged.
model GscConnection {
  id              String              @id @default(cuid())
  tenantId        String              @unique
  /// v1:<iv>:<tag>:<ciphertext> (base64url segments)
  refreshTokenEnc String
  googleEmail     String?
  /// Chosen GSC property (e.g. "sc-domain:example.com"); null until picked.
  siteUrl         String?
  status          GscConnectionStatus @default(ACTIVE)
  connectedAt     DateTime            @default(now())
  lastSyncAt      DateTime?
  updatedAt       DateTime            @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("gsc_connections")
}

enum GscConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
}

/// Daily query-level Search Console rows (nightly sync + manual sync). The
/// Rank Tracker foundation: page = "" marks the query-only aggregate row —
/// an empty-string sentinel rather than NULL so the composite unique key
/// works (Postgres treats NULLs as distinct in unique constraints).
model GscQueryStat {
  id          String   @id @default(cuid())
  tenantId    String
  siteUrl     String
  date        DateTime @db.Date
  query       String
  page        String   @default("")
  clicks      Int
  impressions Int
  ctr         Float
  position    Float

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, query, page])
  @@index([tenantId, query, date])
  @@index([tenantId, date])
  @@map("gsc_query_stats")
}

// -----------------------------------------------------------------------------
// Classic SEO Tools — Phase 0 models (metering + caches).
// NOTE: migration history is unreplayable (docs/agents/BLOCKERS.md §5) —
// use `prisma migrate diff` + `migrate deploy`, not `migrate dev`.
// -----------------------------------------------------------------------------

model SeoApiCall {
  id        String   @id @default(cuid())
  tenantId  String
  feature   String // domain_overview | keyword_research | backlinks | rank_tracking | site_audit | local_seo
  path      String // "v3/dataforseo_labs/google/ranked_keywords/live"
  costUsd   Decimal  @db.Decimal(10, 6)
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model SeoDomainSnapshot {
  id           String   @id @default(cuid())
  tenantId     String
  target       String
  locationCode Int
  languageCode String
  payload      Json
  fetchedAt    DateTime @default(now())

  @@unique([tenantId, target, locationCode, languageCode])
}

model SeoKeywordOverviewCache {
  id           String   @id @default(cuid())
  tenantId     String
  keyword      String
  locationCode Int
  languageCode String
  payload      Json
  fetchedAt    DateTime @default(now()) // 7 d TTL, enforced in code

  @@unique([tenantId, keyword, locationCode, languageCode])
}
