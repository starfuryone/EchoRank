DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echorank?sslmode=disable"
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Redis (BullMQ queue infrastructure)
REDIS_URL="redis://localhost:6379"

# Browser extension import endpoint (/api/extension/import)
# Comma-separated extra CORS origins to allow alongside AUTH_URL. Add your packed
# extension origin here, e.g. chrome-extension://<your-extension-id>
EXTENSION_ALLOWED_ORIGINS=""
# Per-token rate limits (requests and total reviews per window).
EXTENSION_RATE_REQUESTS="12"
EXTENSION_RATE_REVIEWS="1500"
EXTENSION_RATE_WINDOW_SEC="60"

# Optional: SMTP for sending emails (Brevo SMTP relay)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Brevo inbound webhooks (email + SMS delivery/open/click tracking).
# Configure the webhook URLs in Brevo as:
#   email: https://<host>/api/webhooks/brevo?token=<BREVO_WEBHOOK_SECRET>&channel=email
#   sms:   https://<host>/api/webhooks/brevo?token=<BREVO_WEBHOOK_SECRET>&channel=sms
# Brevo does not sign payloads, so this shared secret is the auth.
BREVO_WEBHOOK_SECRET="generate-a-long-random-secret"

# Optional: Stripe for billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_GROWTH_PRICE_ID=""
STRIPE_AGENCY_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# Optional: Twilio for SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# AI / LLM (optional - system uses heuristic fallbacks without this)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Observability
SENTRY_DSN=""
# Client-side Sentry (browser). Safe to expose publicly; enables client error reporting.
NEXT_PUBLIC_SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="echorank"
LOG_LEVEL="info"

# Environment
NODE_ENV="development"

# Google Search Console HTML-tag verification token (the content="..." value).
# The homepage renders <meta name="google-site-verification"> ONLY when this is
# set at build time, so no placeholder can ship. Note public/google*.html
# already provides file-based verification as well.
NEXT_PUBLIC_GSC_TOKEN=

# Brevo transactional API (onboarding email drip — see emails/onboarding/README.md)
BREVO_API_KEY=""
# ONBOARDING_EMAIL_DRY_RUN=1  # log onboarding emails instead of sending
BREVO_ONBOARDING_D0_EN_ID=""
BREVO_ONBOARDING_D0_FR_ID=""
BREVO_ONBOARDING_D2_EN_ID=""
BREVO_ONBOARDING_D2_FR_ID=""
BREVO_ONBOARDING_D5_EN_ID=""
BREVO_ONBOARDING_D5_FR_ID=""
BREVO_ONBOARDING_D10_EN_ID=""
BREVO_ONBOARDING_D10_FR_ID=""
