DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echorank?sslmode=disable"
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Redis (BullMQ queue infrastructure)
REDIS_URL="redis://localhost:6379"

# Optional: SMTP for sending emails
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Optional: Stripe for billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_GROWTH_PRICE_ID=""
STRIPE_AGENCY_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# Optional: Twilio for SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# AI / LLM (optional - system uses heuristic fallbacks without this)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Observability
SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="echorank"
LOG_LEVEL="info"

# Environment
NODE_ENV="development"
