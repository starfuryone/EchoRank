DATABASE_URL="postgresql://postgres:postgres@localhost:5432/echorank?sslmode=disable"
AUTH_SECRET="generate-a-random-secret-here"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Redis (BullMQ queue infrastructure)
REDIS_URL="redis://localhost:6379"

# Browser extension import endpoint (/api/extension/import)
# Comma-separated extra CORS origins to allow alongside AUTH_URL. Add your packed
# extension origin here, e.g. chrome-extension://<your-extension-id>
EXTENSION_ALLOWED_ORIGINS=""
# Per-token rate limits (requests and total reviews per window).
EXTENSION_RATE_REQUESTS="12"
EXTENSION_RATE_REVIEWS="1500"
EXTENSION_RATE_WINDOW_SEC="60"

# Optional: SMTP for sending emails (Brevo SMTP relay)
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Brevo inbound webhooks (email + SMS delivery/open/click tracking).
# Configure the webhook URLs in Brevo as:
#   email: https://<host>/api/webhooks/brevo?token=<BREVO_WEBHOOK_SECRET>&channel=email
#   sms:   https://<host>/api/webhooks/brevo?token=<BREVO_WEBHOOK_SECRET>&channel=sms
# Brevo does not sign payloads, so this shared secret is the auth.
BREVO_WEBHOOK_SECRET="generate-a-long-random-secret"

# Optional: Stripe for billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_STARTER_PRICE_ID=""
STRIPE_GROWTH_PRICE_ID=""
STRIPE_AGENCY_PRICE_ID=""
STRIPE_ENTERPRISE_PRICE_ID=""

# Optional: Twilio for SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# AI / LLM (optional - system uses heuristic fallbacks without this)
AI_PROVIDER="mock"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Observability
SENTRY_DSN=""
# Client-side Sentry (browser). Safe to expose publicly; enables client error reporting.
NEXT_PUBLIC_SENTRY_DSN=""
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
OTEL_SERVICE_NAME="echorank"
LOG_LEVEL="info"

# Environment
NODE_ENV="development"

# Google Search Console HTML-tag verification token (the content="..." value).
# The homepage renders <meta name="google-site-verification"> ONLY when this is
# set at build time, so no placeholder can ship. Note public/google*.html
# already provides file-based verification as well.
NEXT_PUBLIC_GSC_TOKEN=

# Brevo transactional API (onboarding email drip — see emails/onboarding/README.md)
BREVO_API_KEY=""
# ONBOARDING_EMAIL_DRY_RUN=1  # log onboarding emails instead of sending
BREVO_ONBOARDING_D0_EN_ID=""
BREVO_ONBOARDING_D0_FR_ID=""
BREVO_ONBOARDING_D2_EN_ID=""
BREVO_ONBOARDING_D2_FR_ID=""
BREVO_ONBOARDING_D5_EN_ID=""
BREVO_ONBOARDING_D5_FR_ID=""
BREVO_ONBOARDING_D10_EN_ID=""
BREVO_ONBOARDING_D10_FR_ID=""

# ─────────────────────────────────────────────────────────────
# AI Search Intelligence
# ─────────────────────────────────────────────────────────────

# Rollout switch for the AI Search Intelligence surface. DEFAULT OFF: an unset
# value means "not finished", which is the safe reading while the phases land.
# AI_SEARCH_ENABLED=1
# Tenant ids that see it regardless of the switch above, for dogfooding against
# real spend before the global flip. Comma-separated.
# AI_SEARCH_TENANT_IDS=""

# ── Engine API keys ──
# A MISSING KEY DISABLES AN ENGINE; IT NEVER CRASHES A WORKER. Set a key and
# the engine joins the next checkup with no deploy. Availability rules live in
# src/lib/ai-monitor/engines.ts.
#
# ANTHROPIC_API_KEY / OPENAI_API_KEY are declared above and power Claude and
# ChatGPT respectively. DATAFORSEO_LOGIN + DATAFORSEO_PASSWORD (also above)
# power Google AI Overviews, which arrives through the SERP endpoint.
GEMINI_API_KEY=""
PERPLEXITY_API_KEY=""
XAI_API_KEY=""
MISTRAL_API_KEY=""
# Llama is self-hosted or behind a compatible gateway: the HOST is what makes it
# reachable, and a private endpoint may need no key at all.
LLAMA_API_HOST=""
LLAMA_API_KEY=""

# ── Token rates, per 1,000,000 tokens: "input,output,cachedInput" ──
# SET THESE ALONGSIDE THE KEY. A provider whose rates are missing meters at
# ZERO: the calls happen, the monthly cap never sees them, and the first sign of
# trouble is the vendor's invoice. Anthropic ships with built-in rates; nothing
# else does, deliberately — a guessed rate does not fail, it quietly mis-bills.
# The third value defaults to a tenth of input when omitted.
# AI_RATES_CHATGPT="1.25,10,0.125"
# AI_RATES_GEMINI="1.25,10,0.125"
# AI_RATES_PERPLEXITY="1,1,0.1"
# AI_RATES_GROK="3,15,0.3"
# AI_RATES_MISTRAL="2,6,0.2"
# AI_RATES_LLAMA="0,0,0"

# ── AI Assistant (public /{locale}/ai-assistant, and Pro in the dashboard) ──
# THE KILL SWITCH IS RUNTIME AND DEFAULTS ON. Set AI_ASSISTANT_ENABLED to
# "false" (or "0"/"off") to take BOTH assistants offline without a rebuild; the
# API routes read it per request. NEXT_PUBLIC_AI_ASSISTANT_ENABLED is its
# build-time twin and only hides the entry points (marketing nav link, dashboard
# sidebar row, floating widget) — flipping it needs a rebuild, which is exactly
# why it is not the kill switch.
AI_ASSISTANT_ENABLED=""
NEXT_PUBLIC_AI_ASSISTANT_ENABLED=""

# Model ids come from the environment; nothing branches on them in code.
# FAST handles classification and short explanation, REASONING handles
# investigation over evidence and every Pro turn that calls tools.
AI_ASSISTANT_MODEL_FAST=""
AI_ASSISTANT_MODEL_REASONING=""

# Public assistant, per IP per UTC day. A cache hit consumes neither.
AI_ASSISTANT_CHAT_LIMIT_PER_DAY=""
AI_ASSISTANT_SCAN_LIMIT_PER_DAY=""
AI_ASSISTANT_MAX_OUTPUT_TOKENS=""
# Shared monthly ceiling on ANONYMOUS output tokens. 0/unset = no ceiling.
AI_ASSISTANT_MONTHLY_OUTPUT_TOKENS=""

# Pro assistant, per turn. Reaching the tool cap is an ANSWER ("here is what I
# could check"), not an error — see src/lib/assistant/pro/agent.ts.
AI_ASSISTANT_PRO_MAX_TOOL_CALLS=""
AI_ASSISTANT_PRO_MAX_OUTPUT_TOKENS=""

# Pro assistant, per TENANT per calendar month, in output tokens. 0/unset =
# unmetered. Its OWN Redis counter: assistant traffic must never draw down the
# Marketing Studio / Action Agent generation budget, and the two figures have to
# be readable apart when the bill arrives.
AI_ASSISTANT_TENANT_MONTHLY_TOKENS=""
